#: docking.js:2839 appIcons.js:1544
msgid "Unpin"
msgstr "Odepnij"

#: docking.js:2839 appIcons.js:1550
msgid "Pin to Dock"
msgstr "Przypnij do doku"

#: appIcons.js:490
#, javascript-format
msgid "%s is updating, try again later"
msgstr "Aplikacja %s jest aktualizowana, proszę spróbować później"

#: appIcons.js:1454
