msgid_plural "%s, %d unread notifications"
msgstr[0] "%s, %d nieprzeczytane powiadomienie"
msgstr[1] "%s, %d nieprzeczytane powiadomienia"
msgstr[2] "%s, %d nieprzeczytanych powiadomień"

#: locations.js:540
msgid "Mount"
msgstr "Zamontuj"

#: locations.js:542
msgid "Unmount"
msgstr "Odmontuj"

#: locations.js:544
msgid "Eject"
msgstr "Wysuń"

#: locations.js:604
#, javascript-format
msgid "Failed to mount “%s”"
msgstr "Nie udało się zamontować „%s”"

#: locations.js:609
#, javascript-format
msgid "Failed to unmount “%s”"
msgstr "Nie udało się odmontować „%s”"

#: locations.js:614
#, javascript-format
msgid "Failed to eject “%s”"
msgstr "Nie udało się wysunąć „%s”"

#: locations.js:627
msgid "Mount operation already in progress"
msgstr "Zamontowanie jest już w toku"

#: locations.js:632
msgid "Unmount operation already in progress"
msgstr "Odmontowanie jest już w toku"

#: locations.js:637
msgid "Eject operation already in progress"
msgstr "Wysunięcie jest już w toku"

#: locations.js:763 dockPrefs.js:584
msgid "Trash"
msgstr "Kosz"

#: locations.js:804
msgid "Empty Trash"
msgstr "Opróżnij kosz"

#: locations.js:1074
#, javascript-format
msgid "Failed to launch “%s”"
msgstr "Nie udało się uruchomić „%s”"

#: dockPrefs.js:27
msgid "Focus the Window"
msgstr "Aktywuj okno"

#: dockPrefs.js:28
msgid "Focus or Minimise"
msgstr "Aktywuj lub zminimalizuj"

#: dockPrefs.js:29
msgid "Open a New Window"
msgstr "Otwórz nowe okno"

#: dockPrefs.js:30 dockPrefs.js:43
msgid "Cycle Through Windows"
msgstr "Przełączanie między oknami"

#: dockPrefs.js:31
msgid "Minimise or Show in Overview"
msgstr "Zminimalizuj lub wyświetl w podglądzie"

#: dockPrefs.js:32
msgid "Show Window Previews"
msgstr "Wyświetl podglądy okien"

#: dockPrefs.js:33
msgid "Minimise or Show Previews"
msgstr "Zminimalizuj lub wyświetl podglądy"

#: dockPrefs.js:34
msgid "Focus or Show Previews"
msgstr "Aktywuj lub wyświetl podglądy"

#: dockPrefs.js:35
msgid "Focus or Spread Out Windows"
msgstr "Aktywuj lub rozłóż okna"

#: dockPrefs.js:36
msgid "Focus, Minimise or Show Previews"
msgstr "Aktywuj, zminimalizuj lub wyświetl podglądy"

#: dockPrefs.js:37
msgid "Focus, Minimise or Spread Out Windows"
msgstr "Aktywuj, zminimalizuj lub rozłóż okna"

#: dockPrefs.js:38
msgid "Quit the App"
msgstr "Zakończ program"

#: dockPrefs.js:42
msgid "Do Nothing"
msgstr "Nic nie rób"

#: dockPrefs.js:44
msgid "Switch Workspace"
msgstr "Przełącz obszar roboczy"

#: dockPrefs.js:48
msgid "Any Window"
msgstr "Dowolne okno"

#: dockPrefs.js:49
msgid "Windows of the Focused App"
msgstr "Okna aktywnego programu"

#: dockPrefs.js:50
msgid "Maximised Windows Only"
msgstr "Tylko zmaksymalizowane okna"

#: dockPrefs.js:51
msgid "Never, Stay on Top"
msgstr "Nigdy, zawsze na wierzchu"

#: dockPrefs.js:55 dockPrefs.js:61
msgid "Theme Default"
msgstr "Domyślny motywu"

#: dockPrefs.js:56
msgid "Fixed"
msgstr "Ustalona"

#: dockPrefs.js:57
msgid "Adaptive"
msgstr "Dostosowująca się"

#: dockPrefs.js:62
msgid "Dots"
msgstr "Kropki"

#: dockPrefs.js:63
msgid "Squares"
msgstr "Kwadraty"

#: dockPrefs.js:64
msgid "Dashes"
msgstr "Kreski"

#: dockPrefs.js:65
msgid "Segmented Line"
msgstr "Linia segmentowa"

#: dockPrefs.js:66
msgid "Solid Line"
msgstr "Linia ciągła"

#: dockPrefs.js:67
msgid "Line and Dots"
msgstr "Linia i kropki"

#: dockPrefs.js:68
msgid "Full-Width Bar"
msgstr "Pasek na całą szerokość"

#: dockPrefs.js:69
msgid "Binary Count"
msgstr "Licznik binarny"

#: dockPrefs.js:70
msgid "Single Dot"
msgstr "Jedna kropka"

#: dockPrefs.js:360
msgid "Position"
msgstr "Położenie"

#: dockPrefs.js:373
msgid "Placement"
msgstr "Położenie"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Right"
msgstr "Po prawej"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Left"
msgstr "Po lewej"

#: dockPrefs.js:381
msgid "Bottom"
msgstr "Na dole"

#: dockPrefs.js:382
msgid "Top"
msgstr "U góry"

#: dockPrefs.js:387
msgid "Screen Edge"
msgstr "Krawędź ekranu"

#: dockPrefs.js:391
msgid "Show on All Monitors"
msgstr "Na wszystkich monitorach"

#: dockPrefs.js:394
msgid "Monitor"
msgstr "Monitor"

#: dockPrefs.js:395
msgid "The monitor the dock appears on"
msgstr "Monitor, na którym pojawia się dok"

#. Translators: followed by the monitor's name and connector
#: dockPrefs.js:427
msgid "Primary"
msgstr "Główny"

#: dockPrefs.js:442
msgid "Size"
msgstr "Rozmiar"

#: dockPrefs.js:444
msgid "Icon Size"
msgstr "Rozmiar ikon"

#: dockPrefs.js:445
msgid "The largest the icons can be. They shrink to fit when the dock is full."
msgstr "Największy rozmiar ikon. Zmniejszają się, gdy dok jest pełny."

#: dockPrefs.js:450
msgid "Keep Icons at Full Size"
msgstr "Ikony w pełnym rozmiarze"

#: dockPrefs.js:451
msgid ""
"Scroll the dock to reach icons that do not fit, instead of shrinking them"
msgstr ""
"Przewija dok, aby dotrzeć do niemieszczących się ikon, zamiast je zmniejszać"

#: dockPrefs.js:454
msgid "Maximum Length"
msgstr "Maksymalna długość"

#: dockPrefs.js:455
msgid "How much of the screen edge the dock may use"
msgstr "Jaką część krawędzi ekranu może zajmować dok"

#: dockPrefs.js:462
msgid "Stretch to Fill the Edge"
msgstr "Rozciągnięcie na całą krawędź"

#: dockPrefs.js:463
msgid "The dock runs the full length of the screen edge, like a panel"
msgstr "Dok zajmuje całą długość krawędzi ekranu, jak panel"

#: dockPrefs.js:464
msgid "Centre the Icons"
msgstr "Wyśrodkowanie ikon"

#: dockPrefs.js:465
msgid "Keep the icons in the middle of the screen rather than at the start"
msgstr "Utrzymuje ikony na środku ekranu zamiast na początku"

#: dockPrefs.js:467
msgid "Show Apps Button at the Edge"
msgstr "Przycisk Wyświetl programy przy krawędzi"

#: dockPrefs.js:468
msgid ""
"Keep the Show Apps button at the end of the dock when the icons are centred"
msgstr ""
"Utrzymuje przycisk Wyświetl programy na końcu doku, gdy ikony są wyśrodkowane"

#: dockPrefs.js:479
msgid "Visibility"
msgstr "Widoczność"

#: dockPrefs.js:481
msgid ""
"When the dock hides, it comes back when you move the pointer to its edge of "
"the screen."
msgstr ""
"Gdy dok się ukryje, wraca po przesunięciu kursora do jego krawędzi ekranu."

#: dockPrefs.js:485
msgid "Always Visible"
msgstr "Zawsze widoczny"

#: dockPrefs.js:486
msgid ""
"Keep the dock on screen and fit windows around it. Turn off to let the dock "
"hide."
msgstr ""
"Dok zostaje na ekranie, a okna dopasowują się do niego. Wyłącz, aby dok mógł "
"się ukrywać."

#: dockPrefs.js:489
msgid "Hide When Windows Overlap"
msgstr "Ukrywanie, gdy okna nachodzą"

#: dockPrefs.js:490
msgid "The dock steps aside when a window would cover it"
msgstr "Dok usuwa się, gdy okno miałoby go zasłonić"

#: dockPrefs.js:491
msgid "Windows That Hide the Dock"
msgstr "Okna ukrywające dok"

#: dockPrefs.js:496
msgid "Show When Pointer Reaches the Edge"
msgstr "Wyświetlanie, gdy kursor dotrze do krawędzi"

#: dockPrefs.js:497
msgid "Reveal the hidden dock by moving the pointer to the screen edge"
msgstr "Wyświetla ukryty dok po przesunięciu kursora do krawędzi ekranu"

#: dockPrefs.js:498
msgid "Push to Reveal"
msgstr "Wyświetlanie po naparciu"

#: dockPrefs.js:499
msgid ""
"Only show the dock when you push the pointer against the edge, to avoid "
"showing it by accident"
msgstr ""
"Wyświetla dok tylko po naparciu kursorem na krawędź, aby nie pojawiał się "
"przypadkiem"

#: dockPrefs.js:502
msgid "Push Strength"
msgstr "Siła naporu"

#: dockPrefs.js:503
msgid "How hard you need to push, in pixels of pointer movement"
msgstr "Jak mocno trzeba naprzeć, w pikselach ruchu kursora"

#: dockPrefs.js:506
msgid "Show Delay"
msgstr "Opóźnienie wyświetlenia"

#: dockPrefs.js:507
msgid "Seconds to wait at the edge before the dock appears"
msgstr "Sekundy oczekiwania przy krawędzi przed pojawieniem się doku"

#: dockPrefs.js:510
msgid "Also in Full-Screen Apps"
msgstr "Także w programach pełnoekranowych"

#: dockPrefs.js:511
msgid "Allow the dock to appear over full-screen windows"
msgstr "Zezwala na wyświetlanie doku nad oknami pełnoekranowymi"

#: dockPrefs.js:513
msgid "Show for Apps That Need Attention"
msgstr "Wyświetlanie dla programów wymagających uwagi"

#: dockPrefs.js:514
msgid "Briefly show the dock when an app asks for your attention"
msgstr "Na chwilę wyświetla dok, gdy program wymaga uwagi"

#: dockPrefs.js:518
msgid "Hide Delay"
msgstr "Opóźnienie ukrycia"

#: dockPrefs.js:519
msgid "Seconds to wait after the pointer leaves before the dock hides"
msgstr ""
"Sekundy oczekiwania po opuszczeniu doku przez kursor przed jego ukryciem"

#: dockPrefs.js:523
msgid "Animation Duration"
msgstr "Czas trwania animacji"

#: dockPrefs.js:524
msgid "Seconds the dock takes to slide in and out"
msgstr "Sekundy potrzebne dokowi na wsunięcie i wysunięcie"

#: dockPrefs.js:537
msgid "Behaviour"
msgstr "Zachowanie"

#: dockPrefs.js:556
msgid "StackDock Extras"
msgstr "Dodatki StackDock"

#: dockPrefs.js:557
msgid "Optional features added by StackDock."
msgstr "Opcjonalne funkcje dodane przez StackDock."

#: dockPrefs.js:560
msgid "Previews on Hover"
msgstr "Podglądy po najechaniu"

#: dockPrefs.js:561
msgid "Show an app's windows when the pointer rests on its icon"
msgstr "Wyświetla okna programu, gdy kursor spoczywa na jego ikonie"

#: dockPrefs.js:562
msgid "Delay"
msgstr "Opóźnienie"

#: dockPrefs.js:563
msgid "Milliseconds to wait before the previews appear"
msgstr "Milisekundy oczekiwania przed pojawieniem się podglądów"

#: dockPrefs.js:566
msgid "Bounce While Launching"
msgstr "Podskakiwanie podczas uruchamiania"

#: dockPrefs.js:567
msgid "Bounce an app's icon while it starts, until its window appears"
msgstr ""
"Ikona programu podskakuje podczas uruchamiania, dopóki nie pojawi się jego "
"okno"

#: dockPrefs.js:569
msgid "Match the Top Bar"
msgstr "Dopasowanie górnego paska"

#: dockPrefs.js:570
msgid "Give the top bar the same colour and opacity as the dock"
msgstr "Nadaje górnemu paskowi ten sam kolor i nieprzezroczystość co dokowi"

#: dockPrefs.js:579
msgid "Dock Contents"
msgstr "Zawartość doku"

#: dockPrefs.js:581
msgid "Pinned Apps"
msgstr "Przypięte programy"

#: dockPrefs.js:582
msgid "Running Apps"
msgstr "Uruchomione programy"

#: dockPrefs.js:583
msgid "Apps that are open but not pinned"
msgstr "Programy otwarte, ale nieprzypięte"

#: dockPrefs.js:586
msgid "Show Apps Button"
msgstr "Przycisk Wyświetl programy"

#: dockPrefs.js:587
msgid "Opens the app grid"
msgstr "Otwiera siatkę programów"

#: dockPrefs.js:588
msgid "Place at the Start"
msgstr "Na początku"

#: dockPrefs.js:589
msgid "Put the button before the apps instead of after them"
msgstr "Umieszcza przycisk przed programami zamiast po nich"

#: dockPrefs.js:598
msgid "Workspaces and Monitors"
msgstr "Obszary robocze i monitory"

#: dockPrefs.js:604
msgid "Only Apps on the Current Workspace"
msgstr "Tylko programy z bieżącego obszaru roboczego"

#: dockPrefs.js:615
msgid "Show running apps only on the workspace they are on"
msgstr "Wyświetla uruchomione programy tylko na ich obszarze roboczym"

#: dockPrefs.js:616
msgid "Follows the Multitasking setting in GNOME Settings"
msgstr "Zgodnie z ustawieniem Wielozadaniowość w Ustawieniach GNOME"

#: dockPrefs.js:632
msgid "Show Apps Needing Attention Everywhere"
msgstr "Programy wymagające uwagi wszędzie"

#: dockPrefs.js:633
msgid "Apps asking for attention appear on every workspace"
msgstr "Programy wymagające uwagi pojawiają się na każdym obszarze roboczym"

#: dockPrefs.js:635
msgid "Only Apps on the Same Monitor"
msgstr "Tylko programy z tego samego monitora"

#: dockPrefs.js:636
msgid "With a dock on each monitor, each shows only the apps on its monitor"
msgstr ""
"Przy doku na każdym monitorze każdy wyświetla tylko programy ze swojego "
"monitora"

#: dockPrefs.js:639
msgid "Separate Trash and Drive Windows"
msgstr "Oddzielanie okien kosza i napędów"

#: dockPrefs.js:640
msgid "Treat Files windows showing the trash or a drive as their own icons"
msgstr "Traktuje okna Plików wyświetlające kosz lub napęd jako osobne ikony"

#: dockPrefs.js:652
msgid "Clicking and Scrolling"
msgstr "Klikanie i przewijanie"

#: dockPrefs.js:653
msgid "What happens when you click an app that is already open."
msgstr "Co się dzieje po kliknięciu już otwartego programu."

#: dockPrefs.js:658
msgid "Click"
msgstr "Kliknięcie"

#: dockPrefs.js:662
msgid "Other Clicks"
msgstr "Inne kliknięcia"

#: dockPrefs.js:663
msgid "Shift+click, middle-click and Shift+middle-click"
msgstr ""
"Shift+kliknięcie, kliknięcie środkowym przyciskiem i Shift+kliknięcie "
"środkowym przyciskiem"

#: dockPrefs.js:665
msgid "Shift+Click"
msgstr "Shift+kliknięcie"

#: dockPrefs.js:666
msgid "Middle-Click"
msgstr "Kliknięcie środkowym przyciskiem"

#: dockPrefs.js:667
msgid "Shift+Middle-Click"
msgstr "Shift+kliknięcie środkowym przyciskiem"

#: dockPrefs.js:671
msgid "Scroll"
msgstr "Przewijanie"

#: dockPrefs.js:674
msgid ""
"Only works between icons, because Keep Icons at Full Size scrolls the dock"
msgstr ""
"Działa tylko między ikonami, ponieważ „Ikony w pełnym rozmiarze” przewija dok"

#: dockPrefs.js:675
msgid "Scrolling over an app's icon"
msgstr "Przewijanie nad ikoną programu"

#: dockPrefs.js:684
msgid "Window Previews"
msgstr "Podglądy okien"

#: dockPrefs.js:686
msgid "Previews in App Menus"
msgstr "Podglądy w menu programów"

#: dockPrefs.js:687
msgid "Show pictures of the open windows instead of a list of their names"
msgstr "Wyświetla obrazy otwartych okien zamiast listy ich nazw"

#: dockPrefs.js:689
msgid "Preview Size"
msgstr "Rozmiar podglądów"

#: dockPrefs.js:690
msgid "Leave at Automatic to fit the screen"
msgstr "Pozostaw Automatycznie, aby dopasować do ekranu"

#: dockPrefs.js:692 stacks.js:2239 stacksPrefs.js:105
msgid "Automatic"
msgstr "Automatycznie"

#: dockPrefs.js:700
msgid "Icons"
msgstr "Ikony"

#: dockPrefs.js:702
msgid "Wiggle Apps Needing Attention"
msgstr "Poruszanie programami wymagającymi uwagi"

#: dockPrefs.js:703
msgid "Hide Name Tooltips"
msgstr "Ukrywanie podpowiedzi z nazwą"

#: dockPrefs.js:704
msgid "Don't show the app's name when the pointer rests on its icon"
msgstr "Nie wyświetla nazwy programu, gdy kursor spoczywa na jego ikonie"

#: dockPrefs.js:705
msgid "Keep the Focused App in View"
msgstr "Aktywny program zawsze w widoku"

#: dockPrefs.js:706
msgid "Scroll the dock so the icon of the focused app is always visible"
msgstr "Przewija dok tak, aby ikona aktywnego programu była zawsze widoczna"

#: dockPrefs.js:708
msgid "Badges"
msgstr "Plakietki"

#: dockPrefs.js:709
msgid "Counters and progress bars on app icons"
msgstr "Liczniki i paski postępu na ikonach programów"

#: dockPrefs.js:711
msgid "Unread Notification Count"
msgstr "Liczba nieprzeczytanych powiadomień"

#: dockPrefs.js:714
msgid "Prefer the App's Own Count"
msgstr "Preferowanie licznika programu"

#: dockPrefs.js:715
msgid "Apps that set their own badge show it instead of the notification count"
msgstr ""
"Programy z własnym licznikiem wyświetlają go zamiast liczby powiadomień"

#: dockPrefs.js:725
msgid "Keyboard"
msgstr "Klawiatura"

#: dockPrefs.js:727
msgid "Open Apps with Super+Number"
msgstr "Otwieranie programów klawiszami Super+cyfra"

#: dockPrefs.js:728
msgid ""
"Super+1 to Super+0 open the first ten apps. Add Shift or Ctrl for more "
"actions."
msgstr ""
"Klawisze od Super+1 do Super+0 otwierają pierwsze dziesięć programów. Dodaj "
"Shift lub Ctrl, aby uzyskać więcej działań."

#: dockPrefs.js:729
msgid "Show Numbers on Icons"
msgstr "Numery na ikonach"

#: dockPrefs.js:730
msgid "Show each app's number while the shortcut below is held"
msgstr "Wyświetla numer każdego programu, gdy poniższy skrót jest przytrzymany"

#: dockPrefs.js:731
msgid "Show the Dock"
msgstr "Wyświetlanie doku"

#: dockPrefs.js:732
msgid "Briefly show a hidden dock when the shortcut below is pressed"
msgstr "Na chwilę wyświetla ukryty dok po naciśnięciu poniższego skrótu"

#: dockPrefs.js:735
msgid "Shortcut to Show Numbers"
msgstr "Skrót wyświetlający numery"

#: dockPrefs.js:744
msgid "For example &lt;Super&gt;q"
msgstr "Na przykład &lt;Super&gt;q"

#: dockPrefs.js:751
msgid "Numbers Stay For"
msgstr "Numery widoczne przez"

#: dockPrefs.js:752
msgid "Seconds the numbers and dock stay visible"
msgstr "Sekundy, przez które numery i dok pozostają widoczne"

#: dockPrefs.js:759
msgid "Startup"
msgstr "Uruchamianie"

#: dockPrefs.js:761
msgid "Show the Overview at Login"
msgstr "Podgląd po zalogowaniu"

#: dockPrefs.js:762
msgid "Open Activities when you log in, as GNOME does by default"
msgstr "Otwiera Podgląd po zalogowaniu, tak jak domyślnie robi to GNOME"

#: dockPrefs.js:773
msgid "Appearance"
msgstr "Wygląd"

#: dockPrefs.js:786 dockPrefs.js:856
msgid "Style"
msgstr "Styl"

#: dockPrefs.js:788
msgid "Use the Built-in Style"
msgstr "Wbudowany styl"

#: dockPrefs.js:789
msgid ""
"A ready-made look that suits the default GNOME theme. Turn off to choose the "
"colours, opacity and indicators yourself."
msgstr ""
"Gotowy wygląd pasujący do domyślnego motywu GNOME. Wyłącz, aby samodzielnie "
"wybrać kolory, nieprzezroczystość i wskaźniki."

#: dockPrefs.js:791
msgid "Compact"
msgstr "Kompaktowy"

#: dockPrefs.js:792
msgid "Less padding and smaller rounded corners"
msgstr "Mniejsze odstępy i mniej zaokrąglone narożniki"

#: dockPrefs.js:793
msgid "Square Corners"
msgstr "Proste narożniki"

#: dockPrefs.js:795
msgid "Coloured Icon Backgrounds"
msgstr "Kolorowe tła ikon"

#: dockPrefs.js:796
msgid "Light each running app with its icon's main colour, as Unity did"
msgstr ""
"Podświetla każdy uruchomiony program głównym kolorem jego ikony, jak w Unity"

#: dockPrefs.js:797
msgid "Glossy Finish"
msgstr "Błyszczące wykończenie"

#: dockPrefs.js:805
msgid "Background"
