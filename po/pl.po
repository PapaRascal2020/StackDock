msgstr "Zakończ"

#: appIcons.js:1632
#, javascript-format
msgid "Quit %d Window"
msgid_plural "Quit %d Windows"
msgstr[0] "Zamknij %d okno"
msgstr[1] "Zamknij %d okna"
msgstr[2] "Zamknij %d okien"

#: appIcons.js:1923
msgid "Settings"
msgstr "Ustawienia"

#: appIcons.js:1924 aboutPrefs.js:35
