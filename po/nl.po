#: dockPrefs.js:27
msgid "Focus the Window"
msgstr "Venster focussen"

#: dockPrefs.js:28
msgid "Focus or Minimise"
msgstr "Focussen of minimaliseren"

#: dockPrefs.js:29
msgid "Open a New Window"
msgstr "Een nieuw venster openen"

#: dockPrefs.js:30 dockPrefs.js:43
msgid "Cycle Through Windows"
msgstr "Door vensters bladeren"

#: dockPrefs.js:31
msgid "Minimise or Show in Overview"
msgstr "Minimaliseren of in het overzicht tonen"

#: dockPrefs.js:32
msgid "Show Window Previews"
msgstr "Venstervoorbeelden tonen"

#: dockPrefs.js:33
msgid "Minimise or Show Previews"
msgstr "Minimaliseren of voorbeelden tonen"

#: dockPrefs.js:34
msgid "Focus or Show Previews"
msgstr "Focussen of voorbeelden tonen"

#: dockPrefs.js:35
msgid "Focus or Spread Out Windows"
msgstr "Focussen of vensters spreiden"

#: dockPrefs.js:36
msgid "Focus, Minimise or Show Previews"
msgstr "Focussen, minimaliseren of voorbeelden tonen"

#: dockPrefs.js:37
msgid "Focus, Minimise or Spread Out Windows"
msgstr "Focussen, minimaliseren of vensters spreiden"

#: dockPrefs.js:38
msgid "Quit the App"
msgstr "App afsluiten"

#: dockPrefs.js:42
msgid "Do Nothing"
msgstr "Niets doen"

#: dockPrefs.js:44
msgid "Switch Workspace"
msgstr "Van werkruimte wisselen"

#: dockPrefs.js:48
msgid "Any Window"
msgstr "Elk venster"

#: dockPrefs.js:49
msgid "Windows of the Focused App"
msgstr "Vensters van de gefocuste app"

#: dockPrefs.js:50
msgid "Maximised Windows Only"
msgstr "Alleen gemaximaliseerde vensters"

#: dockPrefs.js:51
msgid "Never, Stay on Top"
msgstr "Nooit, bovenop blijven"

#: dockPrefs.js:55 dockPrefs.js:61
msgid "Theme Default"
msgstr "Standaard van thema"

#: dockPrefs.js:56
msgid "Fixed"
msgstr "Vooringesteld"

#: dockPrefs.js:57
msgid "Adaptive"
msgstr "Aanpassend"

#: dockPrefs.js:62
msgid "Dots"
msgstr "Stipjes"

#: dockPrefs.js:63
msgid "Squares"
msgstr "Vierkantjes"

#: dockPrefs.js:64
msgid "Dashes"
msgstr "Streepjes"

#: dockPrefs.js:65
msgid "Segmented Line"
msgstr "Onderbroken lijn"

#: dockPrefs.js:66
msgid "Solid Line"
msgstr "Doorlopende lijn"

#: dockPrefs.js:67
msgid "Line and Dots"
msgstr "Lijn en punten"

#: dockPrefs.js:68
msgid "Full-Width Bar"
msgstr "Balk over de volle breedte"

#: dockPrefs.js:69
msgid "Binary Count"
msgstr "Binaire telling"

#: dockPrefs.js:70
msgid "Single Dot"
msgstr "Eén punt"

#: dockPrefs.js:360
msgid "Position"
msgstr "Positie"

#: dockPrefs.js:373
msgid "Placement"
msgstr "Plaatsing"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Right"
msgstr "Rechts"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Left"
msgstr "Links"

#: dockPrefs.js:381
msgid "Bottom"
msgstr "Onderaan"

#: dockPrefs.js:382
msgid "Top"
msgstr "Bovenaan"

#: dockPrefs.js:387
msgid "Screen Edge"
msgstr "Schermrand"

#: dockPrefs.js:391
msgid "Show on All Monitors"
msgstr "Op alle beeldschermen tonen"

#: dockPrefs.js:394
msgid "Monitor"
msgstr "Beeldscherm"

#: dockPrefs.js:395
msgid "The monitor the dock appears on"
msgstr "Het beeldscherm waarop het dock verschijnt"

#. Translators: followed by the monitor's name and connector
#: dockPrefs.js:427
msgid "Primary"
msgstr "Hoofdscherm"

#: dockPrefs.js:442
msgid "Size"
msgstr "Grootte"

#: dockPrefs.js:444
msgid "Icon Size"
msgstr "Pictogramgrootte"

#: dockPrefs.js:445
msgid "The largest the icons can be. They shrink to fit when the dock is full."
msgstr ""
"De maximale grootte van de pictogrammen. Ze krimpen als het dock vol is."

#: dockPrefs.js:450
msgid "Keep Icons at Full Size"
msgstr "Pictogrammen op volle grootte houden"

#: dockPrefs.js:451
msgid ""
"Scroll the dock to reach icons that do not fit, instead of shrinking them"
msgstr ""
"Het dock scrollen om pictogrammen te bereiken die niet passen, in plaats van "
"ze te verkleinen"

#: dockPrefs.js:454
msgid "Maximum Length"
msgstr "Maximale lengte"

#: dockPrefs.js:455
msgid "How much of the screen edge the dock may use"
msgstr "Hoeveel van de schermrand het dock mag gebruiken"

#: dockPrefs.js:462
msgid "Stretch to Fill the Edge"
msgstr "De rand vullen"

#: dockPrefs.js:463
msgid "The dock runs the full length of the screen edge, like a panel"
msgstr "Het dock loopt over de volle lengte van de schermrand, als een paneel"

#: dockPrefs.js:464
msgid "Centre the Icons"
msgstr "Pictogrammen centreren"

#: dockPrefs.js:465
msgid "Keep the icons in the middle of the screen rather than at the start"
msgstr ""
"De pictogrammen in het midden van het scherm houden in plaats van aan het "
"begin"

#: dockPrefs.js:467
msgid "Show Apps Button at the Edge"
msgstr "Knop Apps tonen aan de rand"

#: dockPrefs.js:468
msgid ""
"Keep the Show Apps button at the end of the dock when the icons are centred"
msgstr ""
"De knop Apps tonen aan het eind van het dock houden als de pictogrammen "
"gecentreerd zijn"

#: dockPrefs.js:479
msgid "Visibility"
msgstr "Zichtbaarheid"

#: dockPrefs.js:481
msgid ""
"When the dock hides, it comes back when you move the pointer to its edge of "
"the screen."
msgstr ""
"Als het dock verborgen is, komt het terug zodra je de aanwijzer naar zijn "
"schermrand beweegt."

#: dockPrefs.js:485
msgid "Always Visible"
msgstr "Altijd zichtbaar"

#: dockPrefs.js:486
msgid ""
"Keep the dock on screen and fit windows around it. Turn off to let the dock "
"hide."
msgstr ""
"Het dock op het scherm houden en vensters eromheen passen. Zet uit om het "
"dock te laten verbergen."

#: dockPrefs.js:489
msgid "Hide When Windows Overlap"
msgstr "Verbergen als vensters overlappen"

#: dockPrefs.js:490
msgid "The dock steps aside when a window would cover it"
msgstr "Het dock gaat opzij als een venster het zou bedekken"

#: dockPrefs.js:491
msgid "Windows That Hide the Dock"
msgstr "Vensters die het dock verbergen"

#: dockPrefs.js:496
msgid "Show When Pointer Reaches the Edge"
msgstr "Tonen als de aanwijzer de rand bereikt"

#: dockPrefs.js:497
msgid "Reveal the hidden dock by moving the pointer to the screen edge"
msgstr ""
"Het verborgen dock tonen door de aanwijzer naar de schermrand te bewegen"

#: dockPrefs.js:498
msgid "Push to Reveal"
msgstr "Duwen om te tonen"

#: dockPrefs.js:499
msgid ""
"Only show the dock when you push the pointer against the edge, to avoid "
"showing it by accident"
msgstr ""
"Het dock alleen tonen als je de aanwijzer tegen de rand duwt, zodat het niet "
"per ongeluk verschijnt"

#: dockPrefs.js:502
msgid "Push Strength"
msgstr "Duwkracht"

#: dockPrefs.js:503
msgid "How hard you need to push, in pixels of pointer movement"
msgstr "Hoe hard je moet duwen, in pixels aanwijzerbeweging"

#: dockPrefs.js:506
msgid "Show Delay"
msgstr "Toonvertraging"

#: dockPrefs.js:507
msgid "Seconds to wait at the edge before the dock appears"
msgstr "Seconden wachten aan de rand voordat het dock verschijnt"

#: dockPrefs.js:510
msgid "Also in Full-Screen Apps"
msgstr "Ook in schermvullende apps"

#: dockPrefs.js:511
msgid "Allow the dock to appear over full-screen windows"
msgstr "Het dock mag boven schermvullende vensters verschijnen"

#: dockPrefs.js:513
msgid "Show for Apps That Need Attention"
msgstr "Tonen voor apps die aandacht vragen"

#: dockPrefs.js:514
msgid "Briefly show the dock when an app asks for your attention"
msgstr "Het dock kort tonen als een app om aandacht vraagt"

#: dockPrefs.js:518
msgid "Hide Delay"
msgstr "Verbergvertraging"

#: dockPrefs.js:519
msgid "Seconds to wait after the pointer leaves before the dock hides"
msgstr ""
"Seconden wachten nadat de aanwijzer vertrekt voordat het dock verdwijnt"

#: dockPrefs.js:523
msgid "Animation Duration"
msgstr "Animatieduur"

#: dockPrefs.js:524
msgid "Seconds the dock takes to slide in and out"
msgstr "Seconden die het dock nodig heeft om in en uit te schuiven"

#: dockPrefs.js:537
msgid "Behaviour"
msgstr "Gedrag"

#: dockPrefs.js:556
msgid "StackDock Extras"
msgstr "StackDock-extra's"

#: dockPrefs.js:557
msgid "Optional features added by StackDock."
msgstr "Optionele functies van StackDock."

#: dockPrefs.js:560
msgid "Previews on Hover"
msgstr "Voorbeelden bij aanwijzen"

#: dockPrefs.js:561
msgid "Show an app's windows when the pointer rests on its icon"
msgstr "De vensters van een app tonen als de aanwijzer op het pictogram rust"

#: dockPrefs.js:562
msgid "Delay"
msgstr "Vertraging"

#: dockPrefs.js:563
msgid "Milliseconds to wait before the previews appear"
msgstr "Milliseconden wachten voordat de voorbeelden verschijnen"

#: dockPrefs.js:566
msgid "Bounce While Launching"
msgstr "Stuiteren bij starten"

#: dockPrefs.js:567
msgid "Bounce an app's icon while it starts, until its window appears"
msgstr ""
"Het pictogram van een app laten stuiteren tijdens het starten, tot het "
"venster verschijnt"

#: dockPrefs.js:569
msgid "Match the Top Bar"
msgstr "Bovenbalk laten aansluiten"

#: dockPrefs.js:570
msgid "Give the top bar the same colour and opacity as the dock"
msgstr "De bovenbalk dezelfde kleur en doorzichtigheid geven als het dock"

#: dockPrefs.js:579
msgid "Dock Contents"
msgstr "Inhoud van het dock"

#: dockPrefs.js:581
msgid "Pinned Apps"
msgstr "Vastgezette apps"

#: dockPrefs.js:582
msgid "Running Apps"
msgstr "Geopende apps"

#: dockPrefs.js:583
msgid "Apps that are open but not pinned"
msgstr "Apps die open zijn maar niet vastgezet"

#: dockPrefs.js:586
msgid "Show Apps Button"
msgstr "Knop Apps tonen"

#: dockPrefs.js:587
msgid "Opens the app grid"
msgstr "Opent het app-raster"

#: dockPrefs.js:588
msgid "Place at the Start"
msgstr "Aan het begin plaatsen"

#: dockPrefs.js:589
msgid "Put the button before the apps instead of after them"
msgstr "De knop vóór de apps plaatsen in plaats van erna"

#: dockPrefs.js:598
msgid "Workspaces and Monitors"
msgstr "Werkruimten en beeldschermen"

#: dockPrefs.js:604
msgid "Only Apps on the Current Workspace"
msgstr "Alleen apps op de huidige werkruimte"

#: dockPrefs.js:615
msgid "Show running apps only on the workspace they are on"
msgstr "Geopende apps alleen tonen op de werkruimte waar ze staan"

#: dockPrefs.js:616
msgid "Follows the Multitasking setting in GNOME Settings"
msgstr "Volgt de instelling Multitasking in GNOME-instellingen"

#: dockPrefs.js:632
msgid "Show Apps Needing Attention Everywhere"
msgstr "Apps die aandacht vragen overal tonen"

#: dockPrefs.js:633
msgid "Apps asking for attention appear on every workspace"
msgstr "Apps die aandacht vragen verschijnen op elke werkruimte"

#: dockPrefs.js:635
msgid "Only Apps on the Same Monitor"
msgstr "Alleen apps op hetzelfde beeldscherm"

#: dockPrefs.js:636
msgid "With a dock on each monitor, each shows only the apps on its monitor"
msgstr ""
"Met een dock op elk beeldscherm toont elk alleen de apps op dat beeldscherm"

#: dockPrefs.js:639
msgid "Separate Trash and Drive Windows"
msgstr "Prullenbak- en stationvensters scheiden"

#: dockPrefs.js:640
msgid "Treat Files windows showing the trash or a drive as their own icons"
msgstr ""
"Bestanden-vensters met de prullenbak of een station als eigen pictogrammen "
"behandelen"

#: dockPrefs.js:652
msgid "Clicking and Scrolling"
msgstr "Klikken en scrollen"

#: dockPrefs.js:653
msgid "What happens when you click an app that is already open."
msgstr "Wat er gebeurt als je klikt op een app die al open is."

#: dockPrefs.js:658
msgid "Click"
msgstr "Klik"

#: dockPrefs.js:662
msgid "Other Clicks"
msgstr "Andere klikken"

#: dockPrefs.js:663
msgid "Shift+click, middle-click and Shift+middle-click"
msgstr "Shift+klik, middelklik en Shift+middelklik"

#: dockPrefs.js:665
msgid "Shift+Click"
msgstr "Shift+klik"

#: dockPrefs.js:666
msgid "Middle-Click"
msgstr "Middelklik"

#: dockPrefs.js:667
msgid "Shift+Middle-Click"
msgstr "Shift+middelklik"

#: dockPrefs.js:671
msgid "Scroll"
msgstr "Scrollen"

#: dockPrefs.js:674
msgid ""
"Only works between icons, because Keep Icons at Full Size scrolls the dock"
msgstr ""
"Werkt alleen tussen pictogrammen, omdat ‘Pictogrammen op volle grootte "
"houden’ het dock laat scrollen"

#: dockPrefs.js:675
msgid "Scrolling over an app's icon"
msgstr "Scrollen boven het pictogram van een app"

#: dockPrefs.js:684
msgid "Window Previews"
msgstr "Venstervoorbeelden"

#: dockPrefs.js:686
msgid "Previews in App Menus"
msgstr "Voorbeelden in app-menu's"

#: dockPrefs.js:687
msgid "Show pictures of the open windows instead of a list of their names"
msgstr ""
"Afbeeldingen van de geopende vensters tonen in plaats van een lijst met namen"

#: dockPrefs.js:689
msgid "Preview Size"
msgstr "Grootte van voorbeelden"

#: dockPrefs.js:690
msgid "Leave at Automatic to fit the screen"
msgstr "Laat op Automatisch staan om bij het scherm te passen"

#: dockPrefs.js:692 stacks.js:2239 stacksPrefs.js:105
msgid "Automatic"
msgstr "Automatisch"

#: dockPrefs.js:700
msgid "Icons"
msgstr "Pictogrammen"

#: dockPrefs.js:702
msgid "Wiggle Apps Needing Attention"
msgstr "Apps die aandacht vragen laten wiebelen"

#: dockPrefs.js:703
msgid "Hide Name Tooltips"
msgstr "Naamtips verbergen"

#: dockPrefs.js:704
msgid "Don't show the app's name when the pointer rests on its icon"
msgstr "De naam van de app niet tonen als de aanwijzer op het pictogram rust"

#: dockPrefs.js:705
msgid "Keep the Focused App in View"
msgstr "Gefocuste app in beeld houden"

#: dockPrefs.js:706
msgid "Scroll the dock so the icon of the focused app is always visible"
msgstr ""
"Het dock zo scrollen dat het pictogram van de gefocuste app altijd zichtbaar "
"is"

#: dockPrefs.js:708
msgid "Badges"
msgstr "Badges"

#: dockPrefs.js:709
msgid "Counters and progress bars on app icons"
msgstr "Tellers en voortgangsbalken op app-pictogrammen"

#: dockPrefs.js:711
msgid "Unread Notification Count"
msgstr "Aantal ongelezen meldingen"

#: dockPrefs.js:714
msgid "Prefer the App's Own Count"
msgstr "Eigen teller van de app voorrang geven"

#: dockPrefs.js:715
msgid "Apps that set their own badge show it instead of the notification count"
msgstr "Apps met een eigen badge tonen die in plaats van het aantal meldingen"

#: dockPrefs.js:725
msgid "Keyboard"
msgstr "Toetsenbord"

#: dockPrefs.js:727
msgid "Open Apps with Super+Number"
msgstr "Apps openen met Super+cijfer"

#: dockPrefs.js:728
msgid ""
"Super+1 to Super+0 open the first ten apps. Add Shift or Ctrl for more "
"actions."
msgstr ""
"Super+1 tot Super+0 openen de eerste tien apps. Voeg Shift of Ctrl toe voor "
"meer acties."

#: dockPrefs.js:729
msgid "Show Numbers on Icons"
msgstr "Nummers op pictogrammen tonen"

#: dockPrefs.js:730
msgid "Show each app's number while the shortcut below is held"
msgstr ""
"Het nummer van elke app tonen zolang de sneltoets hieronder ingedrukt is"

#: dockPrefs.js:731
msgid "Show the Dock"
msgstr "Het dock tonen"

#: dockPrefs.js:732
msgid "Briefly show a hidden dock when the shortcut below is pressed"
msgstr ""
"Een verborgen dock kort tonen als de sneltoets hieronder wordt ingedrukt"

#: dockPrefs.js:735
msgid "Shortcut to Show Numbers"
msgstr "Sneltoets om nummers te tonen"

#: dockPrefs.js:744
msgid "For example &lt;Super&gt;q"
msgstr "Bijvoorbeeld &lt;Super&gt;q"

#: dockPrefs.js:751
msgid "Numbers Stay For"
msgstr "Nummers blijven staan"

#: dockPrefs.js:752
msgid "Seconds the numbers and dock stay visible"
msgstr "Seconden dat de nummers en het dock zichtbaar blijven"

#: dockPrefs.js:759
msgid "Startup"
msgstr "Opstarten"

#: dockPrefs.js:761
msgid "Show the Overview at Login"
msgstr "Het overzicht tonen bij aanmelden"

#: dockPrefs.js:762
msgid "Open Activities when you log in, as GNOME does by default"
msgstr "Activiteiten openen bij het aanmelden, zoals GNOME standaard doet"

#: dockPrefs.js:773
msgid "Appearance"
msgstr "Uiterlijk"

#: dockPrefs.js:786 dockPrefs.js:856
msgid "Style"
msgstr "Stijl"

#: dockPrefs.js:788
msgid "Use the Built-in Style"
msgstr "Ingebouwde stijl gebruiken"

#: dockPrefs.js:789
msgid ""
"A ready-made look that suits the default GNOME theme. Turn off to choose the "
"colours, opacity and indicators yourself."
msgstr ""
"Een kant-en-klaar uiterlijk dat past bij het standaard GNOME-thema. Zet uit "
"om zelf de kleuren, doorzichtigheid en indicatoren te kiezen."

#: dockPrefs.js:791
msgid "Compact"
msgstr "Compact"

#: dockPrefs.js:792
msgid "Less padding and smaller rounded corners"
msgstr "Minder opvulling en kleinere afgeronde hoeken"

#: dockPrefs.js:793
msgid "Square Corners"
msgstr "Rechte hoeken"

#: dockPrefs.js:795
msgid "Coloured Icon Backgrounds"
msgstr "Gekleurde pictogramachtergronden"

#: dockPrefs.js:796
msgid "Light each running app with its icon's main colour, as Unity did"
msgstr ""
"Elke geopende app verlichten met de hoofdkleur van het pictogram, zoals "
"Unity deed"

#: dockPrefs.js:797
msgid "Glossy Finish"
msgstr "Glanzende afwerking"

#: dockPrefs.js:805
msgid "Background"
msgstr "Achtergrond"

#: dockPrefs.js:809
msgid "Custom Colour"
msgstr "Eigen kleur"

#: dockPrefs.js:810
msgid "Use your own background colour instead of the theme's"
msgstr "Je eigen achtergrondkleur gebruiken in plaats van die van het thema"

#: dockPrefs.js:812
msgid "Dock Colour"
msgstr "Dockkleur"

#: dockPrefs.js:822
msgid "Opacity"
msgstr "Doorzichtigheid"

#: dockPrefs.js:823
msgid "Adaptive makes the dock more solid when a window is next to it"
msgstr ""
"Aanpassend maakt het dock minder doorzichtig als er een venster naast staat"

#: dockPrefs.js:828
msgid "Fixed Opacity"
msgstr "Vaste doorzichtigheid"

#: dockPrefs.js:834
msgid "Custom Adaptive Range"
msgstr "Eigen aanpassend bereik"

#: dockPrefs.js:835
msgid "Choose how see-through the dock is with and without a window next to it"
msgstr "Kies hoe doorzichtig het dock is met en zonder een venster ernaast"

#: dockPrefs.js:836
msgid "No Window Nearby"
msgstr "Geen venster in de buurt"

#: dockPrefs.js:839
msgid "Window Nearby"
msgstr "Venster in de buurt"

#: dockPrefs.js:851
msgid "Running App Indicators"
msgstr "Indicatoren voor geopende apps"

#: dockPrefs.js:852
msgid ""
"The marks under the icons of open apps. Most styles show one mark per window."
msgstr ""
"De markeringen onder de pictogrammen van geopende apps. De meeste stijlen "
"tonen één markering per venster."

#: dockPrefs.js:861
msgid "Match Each App's Icon"
msgstr "Zoals het pictogram van elke app"

#: dockPrefs.js:861
msgid "Colour the indicators with the icon's main colour"
msgstr "De indicatoren kleuren met de hoofdkleur van het pictogram"

