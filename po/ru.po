#: docking.js:1426
msgid "Dash"
msgstr "Панель"

#: docking.js:2839 appIcons.js:1544
msgid "Unpin"
msgstr "Открепить"

#: docking.js:2839 appIcons.js:1550
msgid "Pin to Dock"
msgstr "Прикрепить к Доку"

#: appIcons.js:490
#, javascript-format
msgid "%s is updating, try again later"
msgstr "%s обновляется, повторите попытку позже"

#: appIcons.js:1454
#, javascript-format
msgid "%s is being updated…"
msgstr "%s обновляется…"

#: appIcons.js:1465
msgid "All Windows"
msgstr "Все окна"

#. Translators: This is the heading of a list of open windows
#: appIcons.js:1477
msgid "Open Windows"
msgstr "Открыть окна"

#: appIcons.js:1497
msgid "New Window"
msgstr "Новое окно"

#: appIcons.js:1516
msgid "Launch using Integrated Graphics Card"
msgstr "Запуск с использованием интегрированной видеокарты"

#: appIcons.js:1517
msgid "Launch using Discrete Graphics Card"
msgstr "Запуск с использованием дискретной видеокарты"

#: appIcons.js:1562 appIcons.js:1588
msgid "App Details"
msgstr "Подробнее о приложении"

#: appIcons.js:1617 appIcons.js:1629
msgid "Quit"
msgstr "Выйти"

#: appIcons.js:1632
#, javascript-format
msgid "Quit %d Window"
msgid_plural "Quit %d Windows"
msgstr[0] "Закрыть %d оконо"
msgstr[1] "Закрыть %d окона"
msgstr[2] "Закрыть %d окон"

#: appIcons.js:1923
msgid "Settings"
msgstr "Настройки"

#: appIcons.js:1924 aboutPrefs.js:35
msgid "About"
msgstr "О расширении"

#: appIconIndicators.js:918
#, javascript-format
msgid "%s, %d unread notification"
msgid_plural "%s, %d unread notifications"
msgstr[0] "%s, %d непрочитанное уведомление"
msgstr[1] "%s, %d непрочитанных уведомления"
msgstr[2] "%s, %d непрочитанных уведомлений"

#: locations.js:540
msgid "Mount"
msgstr "Монтировать"

#: locations.js:542
msgid "Unmount"
msgstr "Размонтировать"

#: locations.js:544
msgid "Eject"
msgstr "Извлечь"

#: locations.js:604
#, javascript-format
msgid "Failed to mount “%s”"
msgstr "Не удалось монтировать “%s”"

#: locations.js:609
#, javascript-format
msgid "Failed to unmount “%s”"
msgstr "Не удалось размонтировать “%s”"

#: locations.js:614
#, javascript-format
msgid "Failed to eject “%s”"
msgstr "Не удалось извлечь “%s”"

#: locations.js:627
msgid "Mount operation already in progress"
msgstr "Операция монтирования уже выполняется"

#: locations.js:632
msgid "Unmount operation already in progress"
msgstr "Операция размонтирования уже выполняется"

#: locations.js:637
msgid "Eject operation already in progress"
msgstr "Операция извлечения уже выполняется"

#: locations.js:763 dockPrefs.js:584
msgid "Trash"
msgstr "Корзина"

#: locations.js:804
msgid "Empty Trash"
msgstr "Очистить Корзину"

#: locations.js:1074
#, javascript-format
msgid "Failed to launch “%s”"
msgstr "Не удалось запустить “%s”"

#: dockPrefs.js:27
msgid "Focus the Window"
msgstr "Переключиться на окно"

#: dockPrefs.js:28
msgid "Focus or Minimise"
msgstr "Фокус или свернуть"

#: dockPrefs.js:29
msgid "Open a New Window"
msgstr "Открыть новое окно"

#: dockPrefs.js:30 dockPrefs.js:43
msgid "Cycle Through Windows"
msgstr "Переключение между окнами"

#: dockPrefs.js:31
msgid "Minimise or Show in Overview"
msgstr "Свернуть или показать в обзоре"

#: dockPrefs.js:32
msgid "Show Window Previews"
msgstr "Показать миниатюры окон"

#: dockPrefs.js:33
msgid "Minimise or Show Previews"
msgstr "Свернуть или показать миниатюры"

#: dockPrefs.js:34
msgid "Focus or Show Previews"
msgstr "Фокус или показать миниатюры"

#: dockPrefs.js:35
msgid "Focus or Spread Out Windows"
msgstr "Фокус или разложить окна"

#: dockPrefs.js:36
msgid "Focus, Minimise or Show Previews"
msgstr "Фокус, свернуть или показать миниатюры"

#: dockPrefs.js:37
msgid "Focus, Minimise or Spread Out Windows"
msgstr "Фокус, свернуть или разложить окна"

#: dockPrefs.js:38
msgid "Quit the App"
msgstr "Завершить приложение"

#: dockPrefs.js:42
msgid "Do Nothing"
msgstr "Ничего не делать"

#: dockPrefs.js:44
msgid "Switch Workspace"
msgstr "Переключить рабочий стол"

#: dockPrefs.js:48
msgid "Any Window"
msgstr "Любое окно"

#: dockPrefs.js:49
msgid "Windows of the Focused App"
msgstr "Окна активного приложения"

#: dockPrefs.js:50
msgid "Maximised Windows Only"
msgstr "Только развёрнутые окна"

#: dockPrefs.js:51
msgid "Never, Stay on Top"
msgstr "Никогда, оставаться поверх"

#: dockPrefs.js:55 dockPrefs.js:61
msgid "Theme Default"
msgstr "По умолчанию темы"

#: dockPrefs.js:56
msgid "Fixed"
msgstr "Постоянная"

#: dockPrefs.js:57
msgid "Adaptive"
msgstr "Адаптивная"

#: dockPrefs.js:62
msgid "Dots"
msgstr "Точки"

#: dockPrefs.js:63
msgid "Squares"
msgstr "Квадраты"

#: dockPrefs.js:64
msgid "Dashes"
msgstr "Линии"

#: dockPrefs.js:65
msgid "Segmented Line"
msgstr "Сегментированная линия"

#: dockPrefs.js:66
msgid "Solid Line"
msgstr "Сплошная линия"

#: dockPrefs.js:67
msgid "Line and Dots"
msgstr "Линия и точки"

#: dockPrefs.js:68
msgid "Full-Width Bar"
msgstr "Полоса во всю ширину"

#: dockPrefs.js:69
msgid "Binary Count"
msgstr "Двоичный счётчик"

#: dockPrefs.js:70
msgid "Single Dot"
msgstr "Одна точка"

#: dockPrefs.js:360
msgid "Position"
msgstr "Положение"

#: dockPrefs.js:373
msgid "Placement"
msgstr "Размещение"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Right"
msgstr "Справа"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Left"
msgstr "Слева"

#: dockPrefs.js:381
msgid "Bottom"
msgstr "Снизу"

#: dockPrefs.js:382
msgid "Top"
msgstr "Сверху"

#: dockPrefs.js:387
msgid "Screen Edge"
msgstr "Край экрана"

#: dockPrefs.js:391
msgid "Show on All Monitors"
msgstr "Показывать на всех мониторах"

#: dockPrefs.js:394
msgid "Monitor"
msgstr "Монитор"

#: dockPrefs.js:395
msgid "The monitor the dock appears on"
msgstr "Монитор, на котором появляется док"

#. Translators: followed by the monitor's name and connector
#: dockPrefs.js:427
msgid "Primary"
msgstr "Основной"

#: dockPrefs.js:442
msgid "Size"
msgstr "Размер"

#: dockPrefs.js:444
msgid "Icon Size"
msgstr "Размер значков"

#: dockPrefs.js:445
msgid "The largest the icons can be. They shrink to fit when the dock is full."
msgstr "Наибольший размер значков. Они уменьшаются, когда док заполнен."

#: dockPrefs.js:450
msgid "Keep Icons at Full Size"
msgstr "Значки полного размера"

#: dockPrefs.js:451
msgid ""
"Scroll the dock to reach icons that do not fit, instead of shrinking them"
msgstr ""
"Прокручивать док до значков, которые не помещаются, вместо их уменьшения"

#: dockPrefs.js:454
msgid "Maximum Length"
msgstr "Наибольшая длина"

#: dockPrefs.js:455
msgid "How much of the screen edge the dock may use"
msgstr "Какую часть края экрана может занимать док"

#: dockPrefs.js:462
msgid "Stretch to Fill the Edge"
msgstr "Растянуть на весь край"

#: dockPrefs.js:463
msgid "The dock runs the full length of the screen edge, like a panel"
msgstr "Док занимает всю длину края экрана, как панель"

#: dockPrefs.js:464
msgid "Centre the Icons"
msgstr "Значки по центру"

#: dockPrefs.js:465
msgid "Keep the icons in the middle of the screen rather than at the start"
msgstr "Держать значки в середине экрана, а не в начале"

#: dockPrefs.js:467
msgid "Show Apps Button at the Edge"
msgstr "Кнопка «Показать приложения» у края"

#: dockPrefs.js:468
msgid ""
"Keep the Show Apps button at the end of the dock when the icons are centred"
msgstr ""
"Держать кнопку «Показать приложения» в конце дока, когда значки по центру"

#: dockPrefs.js:479
msgid "Visibility"
msgstr "Видимость"

#: dockPrefs.js:481
msgid ""
"When the dock hides, it comes back when you move the pointer to its edge of "
"the screen."
msgstr ""
"Скрытый док возвращается, когда указатель подводится к его краю экрана."

#: dockPrefs.js:485
msgid "Always Visible"
msgstr "Всегда видимый"

#: dockPrefs.js:486
msgid ""
"Keep the dock on screen and fit windows around it. Turn off to let the dock "
"hide."
msgstr ""
"Док остаётся на экране, а окна подстраиваются под него. Отключите, чтобы док "
"мог скрываться."

#: dockPrefs.js:489
msgid "Hide When Windows Overlap"
msgstr "Скрывать при перекрытии окнами"

#: dockPrefs.js:490
msgid "The dock steps aside when a window would cover it"
msgstr "Док отодвигается, когда окно может его закрыть"

#: dockPrefs.js:491
msgid "Windows That Hide the Dock"
msgstr "Окна, скрывающие док"

#: dockPrefs.js:496
msgid "Show When Pointer Reaches the Edge"
msgstr "Показывать, когда указатель достигает края"

#: dockPrefs.js:497
msgid "Reveal the hidden dock by moving the pointer to the screen edge"
msgstr "Показывать скрытый док при перемещении указателя к краю экрана"

#: dockPrefs.js:498
msgid "Push to Reveal"
msgstr "Показывать при упоре"

#: dockPrefs.js:499
msgid ""
"Only show the dock when you push the pointer against the edge, to avoid "
"showing it by accident"
msgstr ""
"Показывать док, только когда указатель упирается в край, чтобы он не "
"появлялся случайно"

#: dockPrefs.js:502
msgid "Push Strength"
msgstr "Сила нажатия"

#: dockPrefs.js:503
msgid "How hard you need to push, in pixels of pointer movement"
msgstr "Сила нажатия, в пикселях движения указателя"

#: dockPrefs.js:506
msgid "Show Delay"
msgstr "Задержка показа"

#: dockPrefs.js:507
msgid "Seconds to wait at the edge before the dock appears"
msgstr "Сколько секунд ждать у края, прежде чем появится док"

#: dockPrefs.js:510
msgid "Also in Full-Screen Apps"
msgstr "Также в полноэкранных приложениях"

#: dockPrefs.js:511
msgid "Allow the dock to appear over full-screen windows"
msgstr "Разрешить доку появляться поверх полноэкранных окон"

#: dockPrefs.js:513
msgid "Show for Apps That Need Attention"
msgstr "Показывать для приложений, требующих внимания"

#: dockPrefs.js:514
msgid "Briefly show the dock when an app asks for your attention"
msgstr "Ненадолго показать док, когда приложение требует внимания"

#: dockPrefs.js:518
msgid "Hide Delay"
msgstr "Задержка скрытия"

#: dockPrefs.js:519
msgid "Seconds to wait after the pointer leaves before the dock hides"
msgstr "Сколько секунд ждать после ухода указателя, прежде чем скрыть док"

#: dockPrefs.js:523
msgid "Animation Duration"
msgstr "Длительность анимации"

#: dockPrefs.js:524
msgid "Seconds the dock takes to slide in and out"
msgstr "Сколько секунд док выезжает и уезжает"

#: dockPrefs.js:537
msgid "Behaviour"
msgstr "Поведение"

#: dockPrefs.js:556
msgid "StackDock Extras"
msgstr "Дополнения StackDock"

#: dockPrefs.js:557
msgid "Optional features added by StackDock."
msgstr "Дополнительные функции StackDock."

#: dockPrefs.js:560
msgid "Previews on Hover"
msgstr "Миниатюры при наведении"

#: dockPrefs.js:561
msgid "Show an app's windows when the pointer rests on its icon"
msgstr "Показывать окна приложения, когда указатель находится над его значком"

#: dockPrefs.js:562
msgid "Delay"
msgstr "Задержка"

#: dockPrefs.js:563
msgid "Milliseconds to wait before the previews appear"
msgstr "Сколько миллисекунд ждать до появления миниатюр"

#: dockPrefs.js:566
msgid "Bounce While Launching"
msgstr "Подпрыгивание при запуске"

#: dockPrefs.js:567
msgid "Bounce an app's icon while it starts, until its window appears"
msgstr ""
"Значок приложения подпрыгивает во время запуска, пока не появится его окно"

#: dockPrefs.js:569
msgid "Match the Top Bar"
msgstr "Согласовать верхнюю панель"

#: dockPrefs.js:570
msgid "Give the top bar the same colour and opacity as the dock"
msgstr "Сделать цвет и непрозрачность верхней панели такими же, как у дока"

#: dockPrefs.js:579
msgid "Dock Contents"
msgstr "Содержимое дока"

#: dockPrefs.js:581
msgid "Pinned Apps"
msgstr "Закреплённые приложения"

#: dockPrefs.js:582
msgid "Running Apps"
msgstr "Запущенные приложения"

#: dockPrefs.js:583
msgid "Apps that are open but not pinned"
msgstr "Открытые, но не закреплённые приложения"

#: dockPrefs.js:586
msgid "Show Apps Button"
msgstr "Кнопка «Показать приложения»"

#: dockPrefs.js:587
msgid "Opens the app grid"
msgstr "Открывает сетку приложений"

#: dockPrefs.js:588
msgid "Place at the Start"
msgstr "В начале"

#: dockPrefs.js:589
msgid "Put the button before the apps instead of after them"
msgstr "Размещать кнопку перед приложениями, а не после них"

#: dockPrefs.js:598
msgid "Workspaces and Monitors"
msgstr "Рабочие столы и мониторы"

#: dockPrefs.js:604
msgid "Only Apps on the Current Workspace"
msgstr "Только приложения текущего рабочего стола"

#: dockPrefs.js:615
msgid "Show running apps only on the workspace they are on"
msgstr "Показывать запущенные приложения только на их рабочем столе"

#: dockPrefs.js:616
msgid "Follows the Multitasking setting in GNOME Settings"
msgstr "Следует настройке «Многозадачность» в параметрах GNOME"

#: dockPrefs.js:632
msgid "Show Apps Needing Attention Everywhere"
msgstr "Приложения, требующие внимания, везде"

#: dockPrefs.js:633
msgid "Apps asking for attention appear on every workspace"
msgstr "Приложения, требующие внимания, появляются на каждом рабочем столе"

#: dockPrefs.js:635
msgid "Only Apps on the Same Monitor"
msgstr "Только приложения того же монитора"

#: dockPrefs.js:636
msgid "With a dock on each monitor, each shows only the apps on its monitor"
msgstr ""
"Если док есть на каждом мониторе, каждый показывает только приложения своего "
"монитора"

#: dockPrefs.js:639
msgid "Separate Trash and Drive Windows"
msgstr "Отделять окна корзины и дисков"

#: dockPrefs.js:640
msgid "Treat Files windows showing the trash or a drive as their own icons"
msgstr "Считать окна «Файлов» с корзиной или диском отдельными значками"

#: dockPrefs.js:652
msgid "Clicking and Scrolling"
msgstr "Щелчки и прокрутка"

#: dockPrefs.js:653
msgid "What happens when you click an app that is already open."
msgstr "Что происходит при щелчке по уже открытому приложению."

#: dockPrefs.js:658
msgid "Click"
msgstr "Щелчок"

#: dockPrefs.js:662
msgid "Other Clicks"
msgstr "Другие щелчки"

#: dockPrefs.js:663
msgid "Shift+click, middle-click and Shift+middle-click"
msgstr "Shift+щелчок, средний щелчок и Shift+средний щелчок"

#: dockPrefs.js:665
msgid "Shift+Click"
msgstr "Shift+щелчок"

#: dockPrefs.js:666
msgid "Middle-Click"
msgstr "Средний щелчок"

#: dockPrefs.js:667
msgid "Shift+Middle-Click"
msgstr "Shift+средний щелчок"

#: dockPrefs.js:671
msgid "Scroll"
msgstr "Прокрутка"

#: dockPrefs.js:674
msgid ""
"Only works between icons, because Keep Icons at Full Size scrolls the dock"
msgstr ""
"Работает только между значками, потому что «Значки полного размера» "
"прокручивает док"

#: dockPrefs.js:675
msgid "Scrolling over an app's icon"
msgstr "Прокрутка над значком приложения"

#: dockPrefs.js:684
msgid "Window Previews"
msgstr "Миниатюры окон"

#: dockPrefs.js:686
msgid "Previews in App Menus"
msgstr "Миниатюры в меню приложений"

#: dockPrefs.js:687
msgid "Show pictures of the open windows instead of a list of their names"
msgstr "Показывать изображения открытых окон вместо списка их названий"

#: dockPrefs.js:689
msgid "Preview Size"
msgstr "Размер миниатюр"

#: dockPrefs.js:690
msgid "Leave at Automatic to fit the screen"
msgstr "Оставьте «Автоматически», чтобы размер подстраивался под экран"

#: dockPrefs.js:692 stacks.js:2239 stacksPrefs.js:105
msgid "Automatic"
msgstr "Автоматически"

#: dockPrefs.js:700
msgid "Icons"
msgstr "Значки"

#: dockPrefs.js:702
msgid "Wiggle Apps Needing Attention"
msgstr "Покачивать приложения, требующие внимания"

#: dockPrefs.js:703
msgid "Hide Name Tooltips"
msgstr "Скрывать подсказки с названием"

#: dockPrefs.js:704
msgid "Don't show the app's name when the pointer rests on its icon"
msgstr ""
"Не показывать название приложения, когда указатель находится над его значком"

#: dockPrefs.js:705
msgid "Keep the Focused App in View"
msgstr "Активное приложение всегда на виду"

#: dockPrefs.js:706
msgid "Scroll the dock so the icon of the focused app is always visible"
msgstr ""
"Прокручивать док так, чтобы значок активного приложения всегда был виден"

#: dockPrefs.js:708
msgid "Badges"
msgstr "Значки"

#: dockPrefs.js:709
msgid "Counters and progress bars on app icons"
msgstr "Счётчики и индикаторы выполнения на значках приложений"

#: dockPrefs.js:711
msgid "Unread Notification Count"
msgstr "Число непрочитанных уведомлений"

#: dockPrefs.js:714
msgid "Prefer the App's Own Count"
msgstr "Предпочитать счётчик приложения"

#: dockPrefs.js:715
msgid "Apps that set their own badge show it instead of the notification count"
msgstr ""
"Приложения с собственным счётчиком показывают его вместо числа уведомлений"

#: dockPrefs.js:725
msgid "Keyboard"
msgstr "Клавиатура"

#: dockPrefs.js:727
msgid "Open Apps with Super+Number"
msgstr "Открывать приложения клавишами Super+цифра"

#: dockPrefs.js:728
msgid ""
"Super+1 to Super+0 open the first ten apps. Add Shift or Ctrl for more "
"actions."
msgstr ""
"Клавиши от Super+1 до Super+0 открывают первые десять приложений. Добавьте "
"Shift или Ctrl для других действий."

#: dockPrefs.js:729
msgid "Show Numbers on Icons"
msgstr "Номера на значках"

#: dockPrefs.js:730
msgid "Show each app's number while the shortcut below is held"
msgstr "Показывать номер каждого приложения, пока удерживается комбинация ниже"

#: dockPrefs.js:731
msgid "Show the Dock"
msgstr "Показывать док"

#: dockPrefs.js:732
msgid "Briefly show a hidden dock when the shortcut below is pressed"
msgstr "Ненадолго показать скрытый док при нажатии комбинации клавиш ниже"

#: dockPrefs.js:735
msgid "Shortcut to Show Numbers"
msgstr "Комбинация для показа номеров"

#: dockPrefs.js:744
msgid "For example &lt;Super&gt;q"
msgstr "Например, &lt;Super&gt;q"

#: dockPrefs.js:751
msgid "Numbers Stay For"
msgstr "Номера видны"

#: dockPrefs.js:752
msgid "Seconds the numbers and dock stay visible"
msgstr "Сколько секунд номера и док остаются видны"

#: dockPrefs.js:759
msgid "Startup"
msgstr "Запуск"

#: dockPrefs.js:761
msgid "Show the Overview at Login"
msgstr "Показывать обзор при входе"

#: dockPrefs.js:762
msgid "Open Activities when you log in, as GNOME does by default"
msgstr "Открывать «Обзор» при входе в систему, как GNOME делает по умолчанию"

#: dockPrefs.js:773
msgid "Appearance"
msgstr "Внешний вид"

#: dockPrefs.js:786 dockPrefs.js:856
msgid "Style"
msgstr "Стиль"

#: dockPrefs.js:788
msgid "Use the Built-in Style"
msgstr "Встроенный стиль"

#: dockPrefs.js:789
msgid ""
