#: dockPrefs.js:27
msgid "Focus the Window"
msgstr "Focar a janela"

#: dockPrefs.js:28
msgid "Focus or Minimise"
msgstr "Focar ou minimizar"

#: dockPrefs.js:29
msgid "Open a New Window"
msgstr "Abrir uma nova janela"

#: dockPrefs.js:30 dockPrefs.js:43
msgid "Cycle Through Windows"
msgstr "Alternar entre as janelas"

#: dockPrefs.js:31
msgid "Minimise or Show in Overview"
msgstr "Minimizar ou mostrar no panorama"

#: dockPrefs.js:32
msgid "Show Window Previews"
msgstr "Mostrar prévias das janelas"

#: dockPrefs.js:33
msgid "Minimise or Show Previews"
msgstr "Minimizar ou mostrar prévias"

#: dockPrefs.js:34
msgid "Focus or Show Previews"
msgstr "Focar ou mostrar prévias"

#: dockPrefs.js:35
msgid "Focus or Spread Out Windows"
msgstr "Focar ou espalhar as janelas"

#: dockPrefs.js:36
msgid "Focus, Minimise or Show Previews"
msgstr "Focar, minimizar ou mostrar prévias"

#: dockPrefs.js:37
msgid "Focus, Minimise or Spread Out Windows"
msgstr "Focar, minimizar ou espalhar as janelas"

#: dockPrefs.js:38
msgid "Quit the App"
msgstr "Sair do aplicativo"

#: dockPrefs.js:42
msgid "Do Nothing"
msgstr "Não fazer nada"

#: dockPrefs.js:44
msgid "Switch Workspace"
msgstr "Trocar de espaço de trabalho"

#: dockPrefs.js:48
msgid "Any Window"
msgstr "Qualquer janela"

#: dockPrefs.js:49
msgid "Windows of the Focused App"
msgstr "Janelas do aplicativo em foco"

#: dockPrefs.js:50
msgid "Maximised Windows Only"
msgstr "Somente janelas maximizadas"

#: dockPrefs.js:51
msgid "Never, Stay on Top"
msgstr "Nunca, ficar por cima"

#: dockPrefs.js:55 dockPrefs.js:61
msgid "Theme Default"
msgstr "Padrão do tema"

#: dockPrefs.js:56
msgid "Fixed"
msgstr "Fixo"

#: dockPrefs.js:57
msgid "Adaptive"
msgstr "Adaptativa"

#: dockPrefs.js:62
msgid "Dots"
msgstr "Pontos"

#: dockPrefs.js:63
msgid "Squares"
msgstr "Quadrados"

#: dockPrefs.js:64
msgid "Dashes"
msgstr "Traços"

#: dockPrefs.js:65
msgid "Segmented Line"
msgstr "Linha segmentada"

#: dockPrefs.js:66
msgid "Solid Line"
msgstr "Linha contínua"

#: dockPrefs.js:67
msgid "Line and Dots"
msgstr "Linha e pontos"

#: dockPrefs.js:68
msgid "Full-Width Bar"
msgstr "Barra de largura total"

#: dockPrefs.js:69
msgid "Binary Count"
msgstr "Contagem binária"

#: dockPrefs.js:70
msgid "Single Dot"
msgstr "Ponto único"

#: dockPrefs.js:360
msgid "Position"
msgstr "Posição"

#: dockPrefs.js:373
msgid "Placement"
msgstr "Posicionamento"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Right"
msgstr "Direita"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Left"
msgstr "Esquerda"

#: dockPrefs.js:381
msgid "Bottom"
msgstr "Inferior"

#: dockPrefs.js:382
msgid "Top"
msgstr "Superior"

#: dockPrefs.js:387
msgid "Screen Edge"
msgstr "Borda da tela"

#: dockPrefs.js:391
msgid "Show on All Monitors"
msgstr "Mostrar em todos os monitores"

#: dockPrefs.js:394
msgid "Monitor"
msgstr "Monitor"

#: dockPrefs.js:395
msgid "The monitor the dock appears on"
msgstr "O monitor em que a dock aparece"

#. Translators: followed by the monitor's name and connector
#: dockPrefs.js:427
msgid "Primary"
msgstr "Principal"

#: dockPrefs.js:442
msgid "Size"
msgstr "Tamanho"

#: dockPrefs.js:444
msgid "Icon Size"
msgstr "Tamanho dos ícones"

#: dockPrefs.js:445
msgid "The largest the icons can be. They shrink to fit when the dock is full."
msgstr "O tamanho máximo dos ícones. Eles encolhem quando a dock está cheia."

#: dockPrefs.js:450
msgid "Keep Icons at Full Size"
msgstr "Manter os ícones em tamanho total"

#: dockPrefs.js:451
msgid ""
"Scroll the dock to reach icons that do not fit, instead of shrinking them"
msgstr "Rolar a dock para alcançar ícones que não cabem, em vez de reduzi-los"

#: dockPrefs.js:454
msgid "Maximum Length"
msgstr "Comprimento máximo"

#: dockPrefs.js:455
msgid "How much of the screen edge the dock may use"
msgstr "Quanto da borda da tela a dock pode usar"

#: dockPrefs.js:462
msgid "Stretch to Fill the Edge"
msgstr "Esticar até preencher a borda"

#: dockPrefs.js:463
msgid "The dock runs the full length of the screen edge, like a panel"
msgstr "A dock ocupa toda a borda da tela, como um painel"

#: dockPrefs.js:464
msgid "Centre the Icons"
msgstr "Centralizar os ícones"

#: dockPrefs.js:465
msgid "Keep the icons in the middle of the screen rather than at the start"
msgstr "Manter os ícones no meio da tela em vez de no início"

#: dockPrefs.js:467
msgid "Show Apps Button at the Edge"
msgstr "Botão Mostrar aplicativos na borda"

#: dockPrefs.js:468
msgid ""
"Keep the Show Apps button at the end of the dock when the icons are centred"
msgstr ""
"Manter o botão Mostrar aplicativos no fim da dock quando os ícones estiverem "
"centralizados"

#: dockPrefs.js:479
msgid "Visibility"
msgstr "Visibilidade"

#: dockPrefs.js:481
msgid ""
"When the dock hides, it comes back when you move the pointer to its edge of "
"the screen."
msgstr ""
"Quando a dock se oculta, ela volta ao mover o ponteiro para a borda dela na "
"tela."

#: dockPrefs.js:485
msgid "Always Visible"
msgstr "Sempre visível"

#: dockPrefs.js:486
msgid ""
"Keep the dock on screen and fit windows around it. Turn off to let the dock "
"hide."
msgstr ""
"Manter a dock na tela e ajustar as janelas ao redor. Desative para deixar a "
"dock se ocultar."

#: dockPrefs.js:489
msgid "Hide When Windows Overlap"
msgstr "Ocultar quando janelas sobrepuserem"

#: dockPrefs.js:490
msgid "The dock steps aside when a window would cover it"
msgstr "A dock sai do caminho quando uma janela a cobriria"

#: dockPrefs.js:491
msgid "Windows That Hide the Dock"
msgstr "Janelas que ocultam a dock"

#: dockPrefs.js:496
msgid "Show When Pointer Reaches the Edge"
msgstr "Mostrar quando o ponteiro chegar à borda"

#: dockPrefs.js:497
msgid "Reveal the hidden dock by moving the pointer to the screen edge"
msgstr "Revelar a dock oculta movendo o ponteiro até a borda da tela"

#: dockPrefs.js:498
msgid "Push to Reveal"
msgstr "Empurrar para revelar"

#: dockPrefs.js:499
msgid ""
"Only show the dock when you push the pointer against the edge, to avoid "
"showing it by accident"
msgstr ""
"Mostrar a dock só ao empurrar o ponteiro contra a borda, para não mostrá-la "
"por acidente"

#: dockPrefs.js:502
msgid "Push Strength"
msgstr "Força do empurrão"

#: dockPrefs.js:503
msgid "How hard you need to push, in pixels of pointer movement"
msgstr "Quanta força é preciso empurrar, em pixels de movimento do ponteiro"

#: dockPrefs.js:506
msgid "Show Delay"
msgstr "Atraso para mostrar"

#: dockPrefs.js:507
msgid "Seconds to wait at the edge before the dock appears"
msgstr "Segundos de espera na borda antes de a dock aparecer"

#: dockPrefs.js:510
msgid "Also in Full-Screen Apps"
msgstr "Também em aplicativos em tela cheia"

#: dockPrefs.js:511
msgid "Allow the dock to appear over full-screen windows"
msgstr "Permitir que a dock apareça sobre janelas em tela cheia"

#: dockPrefs.js:513
msgid "Show for Apps That Need Attention"
msgstr "Mostrar para aplicativos que pedem atenção"

#: dockPrefs.js:514
msgid "Briefly show the dock when an app asks for your attention"
msgstr "Mostrar brevemente a dock quando um aplicativo pedir sua atenção"

#: dockPrefs.js:518
msgid "Hide Delay"
msgstr "Atraso para ocultar"

#: dockPrefs.js:519
msgid "Seconds to wait after the pointer leaves before the dock hides"
msgstr "Segundos de espera após o ponteiro sair antes de a dock se ocultar"

#: dockPrefs.js:523
msgid "Animation Duration"
msgstr "Duração da animação"

#: dockPrefs.js:524
msgid "Seconds the dock takes to slide in and out"
msgstr "Segundos que a dock leva para entrar e sair"

#: dockPrefs.js:537
msgid "Behaviour"
msgstr "Comportamento"

#: dockPrefs.js:556
msgid "StackDock Extras"
msgstr "Extras do StackDock"

#: dockPrefs.js:557
msgid "Optional features added by StackDock."
msgstr "Recursos opcionais adicionados pelo StackDock."

#: dockPrefs.js:560
msgid "Previews on Hover"
msgstr "Prévias ao passar o ponteiro"

#: dockPrefs.js:561
msgid "Show an app's windows when the pointer rests on its icon"
msgstr ""
"Mostrar as janelas de um aplicativo quando o ponteiro parar sobre o ícone"

#: dockPrefs.js:562
msgid "Delay"
msgstr "Atraso"

#: dockPrefs.js:563
msgid "Milliseconds to wait before the previews appear"
msgstr "Milissegundos de espera antes de as prévias aparecerem"

#: dockPrefs.js:566
msgid "Bounce While Launching"
msgstr "Pular ao iniciar"

#: dockPrefs.js:567
msgid "Bounce an app's icon while it starts, until its window appears"
msgstr ""
"Fazer o ícone de um aplicativo pular enquanto ele inicia, até sua janela "
"aparecer"

#: dockPrefs.js:569
msgid "Match the Top Bar"
msgstr "Combinar a barra superior"

#: dockPrefs.js:570
msgid "Give the top bar the same colour and opacity as the dock"
msgstr "Dar à barra superior a mesma cor e opacidade da dock"

#: dockPrefs.js:579
msgid "Dock Contents"
msgstr "Conteúdo da dock"

#: dockPrefs.js:581
msgid "Pinned Apps"
msgstr "Aplicativos fixados"

#: dockPrefs.js:582
msgid "Running Apps"
msgstr "Aplicativos abertos"

#: dockPrefs.js:583
msgid "Apps that are open but not pinned"
msgstr "Aplicativos abertos, mas não fixados"

#: dockPrefs.js:586
msgid "Show Apps Button"
msgstr "Botão Mostrar aplicativos"

#: dockPrefs.js:587
msgid "Opens the app grid"
msgstr "Abre a grade de aplicativos"

#: dockPrefs.js:588
msgid "Place at the Start"
msgstr "Colocar no início"

#: dockPrefs.js:589
msgid "Put the button before the apps instead of after them"
msgstr "Colocar o botão antes dos aplicativos em vez de depois"

#: dockPrefs.js:598
msgid "Workspaces and Monitors"
msgstr "Espaços de trabalho e monitores"

#: dockPrefs.js:604
msgid "Only Apps on the Current Workspace"
msgstr "Somente aplicativos do espaço de trabalho atual"

#: dockPrefs.js:615
msgid "Show running apps only on the workspace they are on"
msgstr "Mostrar aplicativos abertos somente no espaço de trabalho em que estão"

#: dockPrefs.js:616
msgid "Follows the Multitasking setting in GNOME Settings"
msgstr "Segue a configuração de Multitarefa nas Configurações do GNOME"

#: dockPrefs.js:632
msgid "Show Apps Needing Attention Everywhere"
msgstr "Mostrar em todo lugar os aplicativos que pedem atenção"

#: dockPrefs.js:633
msgid "Apps asking for attention appear on every workspace"
msgstr "Aplicativos que pedem atenção aparecem em todos os espaços de trabalho"

#: dockPrefs.js:635
msgid "Only Apps on the Same Monitor"
msgstr "Somente aplicativos do mesmo monitor"

#: dockPrefs.js:636
msgid "With a dock on each monitor, each shows only the apps on its monitor"
msgstr ""
"Com uma dock em cada monitor, cada uma mostra só os aplicativos do seu "
"monitor"

#: dockPrefs.js:639
msgid "Separate Trash and Drive Windows"
msgstr "Separar janelas da lixeira e das unidades"

#: dockPrefs.js:640
msgid "Treat Files windows showing the trash or a drive as their own icons"
msgstr ""
"Tratar janelas do Arquivos que mostram a lixeira ou uma unidade como ícones "
"próprios"

#: dockPrefs.js:652
msgid "Clicking and Scrolling"
msgstr "Clique e rolagem"

#: dockPrefs.js:653
msgid "What happens when you click an app that is already open."
msgstr "O que acontece ao clicar em um aplicativo que já está aberto."

#: dockPrefs.js:658
msgid "Click"
msgstr "Clique"

#: dockPrefs.js:662
msgid "Other Clicks"
msgstr "Outros cliques"

#: dockPrefs.js:663
msgid "Shift+click, middle-click and Shift+middle-click"
msgstr "Shift+clique, clique do meio e Shift+clique do meio"

#: dockPrefs.js:665
msgid "Shift+Click"
msgstr "Shift+clique"

#: dockPrefs.js:666
msgid "Middle-Click"
msgstr "Clique do meio"

#: dockPrefs.js:667
msgid "Shift+Middle-Click"
msgstr "Shift+clique do meio"

#: dockPrefs.js:671
msgid "Scroll"
msgstr "Rolagem"

#: dockPrefs.js:674
msgid ""
"Only works between icons, because Keep Icons at Full Size scrolls the dock"
msgstr ""
"Só funciona entre ícones, porque “Manter os ícones em tamanho total” rola a "
"dock"

#: dockPrefs.js:675
msgid "Scrolling over an app's icon"
msgstr "Rolagem sobre o ícone de um aplicativo"

#: dockPrefs.js:684
msgid "Window Previews"
msgstr "Prévias das janelas"

#: dockPrefs.js:686
msgid "Previews in App Menus"
msgstr "Prévias nos menus dos aplicativos"

#: dockPrefs.js:687
msgid "Show pictures of the open windows instead of a list of their names"
msgstr "Mostrar imagens das janelas abertas em vez de uma lista de nomes"

#: dockPrefs.js:689
msgid "Preview Size"
msgstr "Tamanho das prévias"

#: dockPrefs.js:690
msgid "Leave at Automatic to fit the screen"
msgstr "Deixe em Automático para ajustar à tela"

#: dockPrefs.js:692 stacks.js:2239 stacksPrefs.js:105
msgid "Automatic"
msgstr "Automático"

#: dockPrefs.js:700
msgid "Icons"
msgstr "Ícones"

#: dockPrefs.js:702
msgid "Wiggle Apps Needing Attention"
msgstr "Balançar aplicativos que pedem atenção"

#: dockPrefs.js:703
msgid "Hide Name Tooltips"
msgstr "Ocultar dicas com o nome"

#: dockPrefs.js:704
msgid "Don't show the app's name when the pointer rests on its icon"
msgstr "Não mostrar o nome do aplicativo quando o ponteiro parar sobre o ícone"

#: dockPrefs.js:705
msgid "Keep the Focused App in View"
msgstr "Manter o aplicativo em foco visível"

#: dockPrefs.js:706
msgid "Scroll the dock so the icon of the focused app is always visible"
msgstr ""
"Rolar a dock para que o ícone do aplicativo em foco fique sempre visível"

#: dockPrefs.js:708
msgid "Badges"
msgstr "Emblemas"

#: dockPrefs.js:709
msgid "Counters and progress bars on app icons"
msgstr "Contadores e barras de progresso nos ícones dos aplicativos"

#: dockPrefs.js:711
msgid "Unread Notification Count"
msgstr "Número de notificações não lidas"

#: dockPrefs.js:714
msgid "Prefer the App's Own Count"
msgstr "Preferir o contador do aplicativo"

#: dockPrefs.js:715
msgid "Apps that set their own badge show it instead of the notification count"
msgstr ""
"Aplicativos com contador próprio o mostram no lugar do número de notificações"

#: dockPrefs.js:725
msgid "Keyboard"
msgstr "Teclado"

#: dockPrefs.js:727
msgid "Open Apps with Super+Number"
msgstr "Abrir aplicativos com Super+número"

#: dockPrefs.js:728
msgid ""
"Super+1 to Super+0 open the first ten apps. Add Shift or Ctrl for more "
"actions."
msgstr ""
"Super+1 a Super+0 abrem os dez primeiros aplicativos. Adicione Shift ou Ctrl "
"para mais ações."

#: dockPrefs.js:729
msgid "Show Numbers on Icons"
msgstr "Mostrar números nos ícones"

#: dockPrefs.js:730
msgid "Show each app's number while the shortcut below is held"
msgstr ""
"Mostrar o número de cada aplicativo enquanto o atalho abaixo estiver "
"pressionado"

#: dockPrefs.js:731
msgid "Show the Dock"
msgstr "Mostrar a dock"

#: dockPrefs.js:732
msgid "Briefly show a hidden dock when the shortcut below is pressed"
msgstr ""
"Mostrar brevemente uma dock oculta quando o atalho abaixo for pressionado"

#: dockPrefs.js:735
msgid "Shortcut to Show Numbers"
msgstr "Atalho para mostrar os números"

#: dockPrefs.js:744
msgid "For example &lt;Super&gt;q"
msgstr "Por exemplo &lt;Super&gt;q"

#: dockPrefs.js:751
msgid "Numbers Stay For"
msgstr "Números visíveis por"

#: dockPrefs.js:752
msgid "Seconds the numbers and dock stay visible"
msgstr "Segundos que os números e a dock ficam visíveis"

#: dockPrefs.js:759
msgid "Startup"
msgstr "Inicialização"

#: dockPrefs.js:761
msgid "Show the Overview at Login"
msgstr "Mostrar o panorama ao entrar"

#: dockPrefs.js:762
msgid "Open Activities when you log in, as GNOME does by default"
msgstr "Abrir Atividades ao entrar, como o GNOME faz por padrão"

#: dockPrefs.js:773
msgid "Appearance"
msgstr "Aparência"

#: dockPrefs.js:786 dockPrefs.js:856
msgid "Style"
msgstr "Estilo"

#: dockPrefs.js:788
msgid "Use the Built-in Style"
msgstr "Usar o estilo integrado"

#: dockPrefs.js:789
msgid ""
"A ready-made look that suits the default GNOME theme. Turn off to choose the "
"colours, opacity and indicators yourself."
msgstr ""
"Uma aparência pronta que combina com o tema padrão do GNOME. Desative para "
"escolher você mesmo as cores, a opacidade e os indicadores."

#: dockPrefs.js:791
msgid "Compact"
msgstr "Compacto"

#: dockPrefs.js:792
msgid "Less padding and smaller rounded corners"
msgstr "Menos preenchimento e cantos menos arredondados"

#: dockPrefs.js:793
msgid "Square Corners"
msgstr "Cantos retos"

#: dockPrefs.js:795
msgid "Coloured Icon Backgrounds"
msgstr "Fundos de ícone coloridos"

#: dockPrefs.js:796
msgid "Light each running app with its icon's main colour, as Unity did"
msgstr ""
"Iluminar cada aplicativo aberto com a cor principal do ícone, como fazia o "
"Unity"

#: dockPrefs.js:797
msgid "Glossy Finish"
msgstr "Acabamento brilhante"

#: dockPrefs.js:805
msgid "Background"
msgstr "Fundo"

#: dockPrefs.js:809
msgid "Custom Colour"
msgstr "Cor personalizada"

#: dockPrefs.js:810
msgid "Use your own background colour instead of the theme's"
msgstr "Usar sua própria cor de fundo em vez da do tema"

#: dockPrefs.js:812
msgid "Dock Colour"
msgstr "Cor da dock"

#: dockPrefs.js:822
msgid "Opacity"
msgstr "Opacidade"

#: dockPrefs.js:823
msgid "Adaptive makes the dock more solid when a window is next to it"
msgstr ""
"A opacidade adaptativa deixa a dock mais sólida quando há uma janela ao lado"

#: dockPrefs.js:828
msgid "Fixed Opacity"
msgstr "Opacidade fixa"

#: dockPrefs.js:834
msgid "Custom Adaptive Range"
msgstr "Intervalo adaptativo personalizado"

#: dockPrefs.js:835
msgid "Choose how see-through the dock is with and without a window next to it"
msgstr "Escolher o quanto a dock é transparente com e sem uma janela ao lado"

#: dockPrefs.js:836
msgid "No Window Nearby"
msgstr "Nenhuma janela por perto"

#: dockPrefs.js:839
msgid "Window Nearby"
msgstr "Janela por perto"

#: dockPrefs.js:851
msgid "Running App Indicators"
msgstr "Indicadores de aplicativos abertos"

#: dockPrefs.js:852
msgid ""
"The marks under the icons of open apps. Most styles show one mark per window."
msgstr ""
"As marcas sob os ícones dos aplicativos abertos. A maioria dos estilos "
"mostra uma marca por janela."

#: dockPrefs.js:861
msgid "Match Each App's Icon"
msgstr "Igual ao ícone de cada aplicativo"

#: dockPrefs.js:861
msgid "Colour the indicators with the icon's main colour"
msgstr "Colorir os indicadores com a cor principal do ícone"

#: dockPrefs.js:866
msgid "Custom Colours"
msgstr "Cores personalizadas"

#: dockPrefs.js:866
msgid "Use the same colours for every app"
msgstr "Usar as mesmas cores para todos os aplicativos"

