#: dockPrefs.js:27
msgid "Focus the Window"
msgstr "Attiva la finestra"

#: dockPrefs.js:28
msgid "Focus or Minimise"
msgstr "Attiva o minimizza"

#: dockPrefs.js:29
msgid "Open a New Window"
msgstr "Apri una nuova finestra"

#: dockPrefs.js:30 dockPrefs.js:43
msgid "Cycle Through Windows"
msgstr "Scorri tra le finestre"

#: dockPrefs.js:31
msgid "Minimise or Show in Overview"
msgstr "Minimizza o mostra nella panoramica"

#: dockPrefs.js:32
msgid "Show Window Previews"
msgstr "Mostra le anteprime delle finestre"

#: dockPrefs.js:33
msgid "Minimise or Show Previews"
msgstr "Minimizza o mostra anteprime"

#: dockPrefs.js:34
msgid "Focus or Show Previews"
msgstr "Attiva o mostra anteprime"

#: dockPrefs.js:35
msgid "Focus or Spread Out Windows"
msgstr "Attiva o disponi le finestre"

#: dockPrefs.js:36
msgid "Focus, Minimise or Show Previews"
msgstr "Attiva, minimizza o mostra anteprime"

#: dockPrefs.js:37
msgid "Focus, Minimise or Spread Out Windows"
msgstr "Attiva, minimizza o disponi le finestre"

#: dockPrefs.js:38
msgid "Quit the App"
msgstr "Chiudi l'applicazione"

#: dockPrefs.js:42
msgid "Do Nothing"
msgstr "Non fare nulla"

#: dockPrefs.js:44
msgid "Switch Workspace"
msgstr "Cambia spazio di lavoro"

#: dockPrefs.js:48
msgid "Any Window"
msgstr "Qualsiasi finestra"

#: dockPrefs.js:49
msgid "Windows of the Focused App"
msgstr "Finestre dell'applicazione attiva"

#: dockPrefs.js:50
msgid "Maximised Windows Only"
msgstr "Solo finestre massimizzate"

#: dockPrefs.js:51
msgid "Never, Stay on Top"
msgstr "Mai, resta in primo piano"

#: dockPrefs.js:55 dockPrefs.js:61
msgid "Theme Default"
msgstr "Predefinito del tema"

#: dockPrefs.js:56
msgid "Fixed"
msgstr "Fisso"

#: dockPrefs.js:57
msgid "Adaptive"
msgstr "Adattivo"

#: dockPrefs.js:62
msgid "Dots"
msgstr "Puntini"

#: dockPrefs.js:63
msgid "Squares"
msgstr "Quadrati"

#: dockPrefs.js:64
msgid "Dashes"
msgstr "Trattini"

#: dockPrefs.js:65
msgid "Segmented Line"
msgstr "Linea segmentata"

#: dockPrefs.js:66
msgid "Solid Line"
msgstr "Linea continua"

#: dockPrefs.js:67
msgid "Line and Dots"
msgstr "Linea e punti"

#: dockPrefs.js:68
msgid "Full-Width Bar"
msgstr "Barra a tutta larghezza"

#: dockPrefs.js:69
msgid "Binary Count"
msgstr "Conteggio binario"

#: dockPrefs.js:70
msgid "Single Dot"
msgstr "Punto singolo"

#: dockPrefs.js:360
msgid "Position"
msgstr "Posizione"

#: dockPrefs.js:373
msgid "Placement"
msgstr "Collocazione"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Right"
msgstr "Destra"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Left"
msgstr "Sinistra"

#: dockPrefs.js:381
msgid "Bottom"
msgstr "Basso"

#: dockPrefs.js:382
msgid "Top"
msgstr "Alto"

#: dockPrefs.js:387
msgid "Screen Edge"
msgstr "Bordo dello schermo"

#: dockPrefs.js:391
msgid "Show on All Monitors"
msgstr "Mostra su tutti i monitor"

#: dockPrefs.js:394
msgid "Monitor"
msgstr "Monitor"

#: dockPrefs.js:395
msgid "The monitor the dock appears on"
msgstr "Il monitor su cui appare la dock"

#. Translators: followed by the monitor's name and connector
#: dockPrefs.js:427
msgid "Primary"
msgstr "Principale"

#: dockPrefs.js:442
msgid "Size"
msgstr "Dimensione"

#: dockPrefs.js:444
msgid "Icon Size"
msgstr "Dimensione icone"

#: dockPrefs.js:445
msgid "The largest the icons can be. They shrink to fit when the dock is full."
msgstr ""
"La dimensione massima delle icone. Si rimpiccioliscono quando la dock è "
"piena."

#: dockPrefs.js:450
msgid "Keep Icons at Full Size"
msgstr "Mantieni le icone a dimensione piena"

#: dockPrefs.js:451
msgid ""
"Scroll the dock to reach icons that do not fit, instead of shrinking them"
msgstr ""
"Scorre la dock per raggiungere le icone che non ci stanno, invece di "
"rimpicciolirle"

#: dockPrefs.js:454
msgid "Maximum Length"
msgstr "Lunghezza massima"

#: dockPrefs.js:455
msgid "How much of the screen edge the dock may use"
msgstr "Quanta parte del bordo dello schermo può usare la dock"

#: dockPrefs.js:462
msgid "Stretch to Fill the Edge"
msgstr "Estendi su tutto il bordo"

#: dockPrefs.js:463
msgid "The dock runs the full length of the screen edge, like a panel"
msgstr ""
"La dock occupa tutta la lunghezza del bordo dello schermo, come un pannello"

#: dockPrefs.js:464
msgid "Centre the Icons"
msgstr "Centra le icone"

#: dockPrefs.js:465
msgid "Keep the icons in the middle of the screen rather than at the start"
msgstr "Mantiene le icone al centro dello schermo invece che all'inizio"

#: dockPrefs.js:467
msgid "Show Apps Button at the Edge"
msgstr "Pulsante Mostra applicazioni sul bordo"

#: dockPrefs.js:468
msgid ""
"Keep the Show Apps button at the end of the dock when the icons are centred"
msgstr ""
"Mantiene il pulsante Mostra applicazioni alla fine della dock quando le "
"icone sono centrate"

#: dockPrefs.js:479
msgid "Visibility"
msgstr "Visibilità"

#: dockPrefs.js:481
msgid ""
"When the dock hides, it comes back when you move the pointer to its edge of "
"the screen."
msgstr ""
"Quando la dock si nasconde, ritorna portando il puntatore sul suo bordo "
"dello schermo."

#: dockPrefs.js:485
msgid "Always Visible"
msgstr "Sempre visibile"

#: dockPrefs.js:486
msgid ""
"Keep the dock on screen and fit windows around it. Turn off to let the dock "
"hide."
msgstr ""
"Mantiene la dock sullo schermo e adatta le finestre intorno. Disattivare per "
"lasciare che la dock si nasconda."

#: dockPrefs.js:489
msgid "Hide When Windows Overlap"
msgstr "Nascondi quando le finestre si sovrappongono"

#: dockPrefs.js:490
msgid "The dock steps aside when a window would cover it"
msgstr "La dock si sposta quando una finestra la coprirebbe"

#: dockPrefs.js:491
msgid "Windows That Hide the Dock"
msgstr "Finestre che nascondono la dock"

#: dockPrefs.js:496
msgid "Show When Pointer Reaches the Edge"
msgstr "Mostra quando il puntatore raggiunge il bordo"

#: dockPrefs.js:497
msgid "Reveal the hidden dock by moving the pointer to the screen edge"
msgstr "Mostra la dock nascosta portando il puntatore sul bordo dello schermo"

#: dockPrefs.js:498
msgid "Push to Reveal"
msgstr "Spingi per mostrare"

#: dockPrefs.js:499
msgid ""
"Only show the dock when you push the pointer against the edge, to avoid "
"showing it by accident"
msgstr ""
"Mostra la dock solo spingendo il puntatore contro il bordo, per evitare di "
"mostrarla per sbaglio"

#: dockPrefs.js:502
msgid "Push Strength"
msgstr "Forza della spinta"

#: dockPrefs.js:503
msgid "How hard you need to push, in pixels of pointer movement"
msgstr "Quanto spingere, in pixel di movimento del puntatore"

#: dockPrefs.js:506
msgid "Show Delay"
msgstr "Ritardo di comparsa"

#: dockPrefs.js:507
msgid "Seconds to wait at the edge before the dock appears"
msgstr "Secondi di attesa sul bordo prima che appaia la dock"

#: dockPrefs.js:510
msgid "Also in Full-Screen Apps"
msgstr "Anche nelle applicazioni a schermo intero"

#: dockPrefs.js:511
msgid "Allow the dock to appear over full-screen windows"
msgstr "Consente alla dock di apparire sopra le finestre a schermo intero"

#: dockPrefs.js:513
msgid "Show for Apps That Need Attention"
msgstr "Mostra per le applicazioni che richiedono attenzione"

#: dockPrefs.js:514
msgid "Briefly show the dock when an app asks for your attention"
msgstr "Mostra brevemente la dock quando un'applicazione richiede attenzione"

#: dockPrefs.js:518
msgid "Hide Delay"
msgstr "Ritardo di nascondimento"

#: dockPrefs.js:519
msgid "Seconds to wait after the pointer leaves before the dock hides"
msgstr ""
"Secondi di attesa dopo l'uscita del puntatore prima che la dock si nasconda"

#: dockPrefs.js:523
msgid "Animation Duration"
msgstr "Durata dell'animazione"

#: dockPrefs.js:524
msgid "Seconds the dock takes to slide in and out"
msgstr "Secondi impiegati dalla dock per entrare e uscire"

#: dockPrefs.js:537
msgid "Behaviour"
msgstr "Comportamento"

#: dockPrefs.js:556
msgid "StackDock Extras"
msgstr "Extra di StackDock"

#: dockPrefs.js:557
msgid "Optional features added by StackDock."
msgstr "Funzionalità facoltative aggiunte da StackDock."

#: dockPrefs.js:560
msgid "Previews on Hover"
msgstr "Anteprime al passaggio"

#: dockPrefs.js:561
msgid "Show an app's windows when the pointer rests on its icon"
msgstr ""
"Mostra le finestre di un'applicazione quando il puntatore si ferma sulla sua "
"icona"

#: dockPrefs.js:562
msgid "Delay"
msgstr "Ritardo"

#: dockPrefs.js:563
msgid "Milliseconds to wait before the previews appear"
msgstr "Millisecondi di attesa prima che appaiano le anteprime"

#: dockPrefs.js:566
msgid "Bounce While Launching"
msgstr "Rimbalza all'avvio"

#: dockPrefs.js:567
msgid "Bounce an app's icon while it starts, until its window appears"
msgstr ""
"Fa rimbalzare l'icona di un'applicazione durante l'avvio, finché non appare "
"la sua finestra"

#: dockPrefs.js:569
msgid "Match the Top Bar"
msgstr "Uniforma la barra superiore"

#: dockPrefs.js:570
msgid "Give the top bar the same colour and opacity as the dock"
msgstr ""
"Dà alla barra superiore lo stesso colore e la stessa opacità della dock"

#: dockPrefs.js:579
msgid "Dock Contents"
msgstr "Contenuto della dock"

#: dockPrefs.js:581
msgid "Pinned Apps"
msgstr "Applicazioni fissate"

#: dockPrefs.js:582
msgid "Running Apps"
msgstr "Applicazioni aperte"

#: dockPrefs.js:583
msgid "Apps that are open but not pinned"
msgstr "Applicazioni aperte ma non fissate"

#: dockPrefs.js:586
msgid "Show Apps Button"
msgstr "Pulsante Mostra applicazioni"

#: dockPrefs.js:587
msgid "Opens the app grid"
msgstr "Apre la griglia delle applicazioni"

#: dockPrefs.js:588
msgid "Place at the Start"
msgstr "Posiziona all'inizio"

#: dockPrefs.js:589
msgid "Put the button before the apps instead of after them"
msgstr "Posiziona il pulsante prima delle applicazioni invece che dopo"

#: dockPrefs.js:598
msgid "Workspaces and Monitors"
msgstr "Spazi di lavoro e monitor"

#: dockPrefs.js:604
msgid "Only Apps on the Current Workspace"
msgstr "Solo applicazioni dello spazio di lavoro attuale"

#: dockPrefs.js:615
msgid "Show running apps only on the workspace they are on"
msgstr "Mostra le applicazioni aperte solo nel loro spazio di lavoro"

#: dockPrefs.js:616
msgid "Follows the Multitasking setting in GNOME Settings"
msgstr "Segue l'impostazione Multitasking delle Impostazioni di GNOME"

#: dockPrefs.js:632
msgid "Show Apps Needing Attention Everywhere"
msgstr "Mostra ovunque le applicazioni che richiedono attenzione"

#: dockPrefs.js:633
msgid "Apps asking for attention appear on every workspace"
msgstr ""
"Le applicazioni che richiedono attenzione appaiono in ogni spazio di lavoro"

#: dockPrefs.js:635
msgid "Only Apps on the Same Monitor"
msgstr "Solo applicazioni dello stesso monitor"

#: dockPrefs.js:636
msgid "With a dock on each monitor, each shows only the apps on its monitor"
msgstr ""
"Con una dock su ogni monitor, ciascuna mostra solo le applicazioni del "
"proprio monitor"

#: dockPrefs.js:639
msgid "Separate Trash and Drive Windows"
msgstr "Separa le finestre del cestino e delle unità"

#: dockPrefs.js:640
msgid "Treat Files windows showing the trash or a drive as their own icons"
msgstr ""
"Tratta le finestre di File che mostrano il cestino o un'unità come icone "
"separate"

#: dockPrefs.js:652
msgid "Clicking and Scrolling"
msgstr "Clic e scorrimento"

#: dockPrefs.js:653
msgid "What happens when you click an app that is already open."
msgstr "Cosa succede quando si fa clic su un'applicazione già aperta."

#: dockPrefs.js:658
msgid "Click"
msgstr "Clic"

#: dockPrefs.js:662
msgid "Other Clicks"
msgstr "Altri clic"

#: dockPrefs.js:663
msgid "Shift+click, middle-click and Shift+middle-click"
msgstr "Maiusc+clic, clic centrale e Maiusc+clic centrale"

#: dockPrefs.js:665
msgid "Shift+Click"
msgstr "Maiusc+clic"

#: dockPrefs.js:666
msgid "Middle-Click"
msgstr "Clic centrale"

#: dockPrefs.js:667
msgid "Shift+Middle-Click"
msgstr "Maiusc+clic centrale"

#: dockPrefs.js:671
msgid "Scroll"
msgstr "Scorrimento"

#: dockPrefs.js:674
msgid ""
"Only works between icons, because Keep Icons at Full Size scrolls the dock"
msgstr ""
"Funziona solo tra le icone, perché «Mantieni le icone a dimensione piena» fa "
"scorrere la dock"

#: dockPrefs.js:675
msgid "Scrolling over an app's icon"
msgstr "Scorrimento sull'icona di un'applicazione"

#: dockPrefs.js:684
msgid "Window Previews"
msgstr "Anteprime delle finestre"

#: dockPrefs.js:686
msgid "Previews in App Menus"
msgstr "Anteprime nei menu delle applicazioni"

#: dockPrefs.js:687
msgid "Show pictures of the open windows instead of a list of their names"
msgstr ""
"Mostra immagini delle finestre aperte invece di un elenco dei loro nomi"

#: dockPrefs.js:689
msgid "Preview Size"
msgstr "Dimensione anteprime"

#: dockPrefs.js:690
msgid "Leave at Automatic to fit the screen"
msgstr "Lasciare su Automatica per adattarsi allo schermo"

#: dockPrefs.js:692 stacks.js:2239 stacksPrefs.js:105
msgid "Automatic"
msgstr "Automatica"

#: dockPrefs.js:700
msgid "Icons"
msgstr "Icone"

#: dockPrefs.js:702
msgid "Wiggle Apps Needing Attention"
msgstr "Fai oscillare le applicazioni che richiedono attenzione"

#: dockPrefs.js:703
msgid "Hide Name Tooltips"
msgstr "Nascondi i suggerimenti con il nome"

#: dockPrefs.js:704
msgid "Don't show the app's name when the pointer rests on its icon"
msgstr ""
"Non mostrare il nome dell'applicazione quando il puntatore si ferma sulla "
"sua icona"

#: dockPrefs.js:705
msgid "Keep the Focused App in View"
msgstr "Mantieni visibile l'applicazione attiva"

#: dockPrefs.js:706
msgid "Scroll the dock so the icon of the focused app is always visible"
msgstr ""
"Scorre la dock in modo che l'icona dell'applicazione attiva sia sempre "
"visibile"

#: dockPrefs.js:708
msgid "Badges"
msgstr "Contrassegni"

#: dockPrefs.js:709
msgid "Counters and progress bars on app icons"
msgstr "Contatori e barre di avanzamento sulle icone delle applicazioni"

#: dockPrefs.js:711
msgid "Unread Notification Count"
msgstr "Numero di notifiche non lette"

#: dockPrefs.js:714
msgid "Prefer the App's Own Count"
msgstr "Preferisci il contatore dell'applicazione"

#: dockPrefs.js:715
msgid "Apps that set their own badge show it instead of the notification count"
msgstr ""
"Le applicazioni con un proprio contatore lo mostrano al posto del numero di "
"notifiche"

#: dockPrefs.js:725
msgid "Keyboard"
msgstr "Tastiera"

#: dockPrefs.js:727
msgid "Open Apps with Super+Number"
msgstr "Apri le applicazioni con Super+numero"

#: dockPrefs.js:728
msgid ""
"Super+1 to Super+0 open the first ten apps. Add Shift or Ctrl for more "
"actions."
msgstr ""
"Da Super+1 a Super+0 si aprono le prime dieci applicazioni. Aggiungere "
"Maiusc o Ctrl per altre azioni."

#: dockPrefs.js:729
msgid "Show Numbers on Icons"
msgstr "Mostra i numeri sulle icone"

#: dockPrefs.js:730
msgid "Show each app's number while the shortcut below is held"
msgstr ""
"Mostra il numero di ogni applicazione mentre si tiene premuta la scorciatoia "
"qui sotto"

#: dockPrefs.js:731
msgid "Show the Dock"
msgstr "Mostra la dock"

#: dockPrefs.js:732
msgid "Briefly show a hidden dock when the shortcut below is pressed"
msgstr ""
"Mostra brevemente una dock nascosta quando si preme la scorciatoia qui sotto"

#: dockPrefs.js:735
msgid "Shortcut to Show Numbers"
msgstr "Scorciatoia per mostrare i numeri"

#: dockPrefs.js:744
msgid "For example &lt;Super&gt;q"
msgstr "Per esempio &lt;Super&gt;q"

#: dockPrefs.js:751
msgid "Numbers Stay For"
msgstr "Durata dei numeri"

#: dockPrefs.js:752
msgid "Seconds the numbers and dock stay visible"
msgstr "Secondi in cui i numeri e la dock restano visibili"

#: dockPrefs.js:759
msgid "Startup"
msgstr "Avvio"

#: dockPrefs.js:761
msgid "Show the Overview at Login"
msgstr "Mostra la panoramica all'accesso"

#: dockPrefs.js:762
msgid "Open Activities when you log in, as GNOME does by default"
msgstr "Apre Attività all'accesso, come fa GNOME in modo predefinito"

#: dockPrefs.js:773
msgid "Appearance"
msgstr "Aspetto"

#: dockPrefs.js:786 dockPrefs.js:856
msgid "Style"
msgstr "Stile"

#: dockPrefs.js:788
msgid "Use the Built-in Style"
msgstr "Usa lo stile integrato"

#: dockPrefs.js:789
msgid ""
"A ready-made look that suits the default GNOME theme. Turn off to choose the "
"colours, opacity and indicators yourself."
msgstr ""
"Un aspetto già pronto, adatto al tema predefinito di GNOME. Disattivarlo per "
"scegliere personalmente colori, opacità e indicatori."

#: dockPrefs.js:791
msgid "Compact"
msgstr "Compatta"

#: dockPrefs.js:792
msgid "Less padding and smaller rounded corners"
msgstr "Meno spaziatura e angoli meno arrotondati"

#: dockPrefs.js:793
msgid "Square Corners"
msgstr "Angoli squadrati"

#: dockPrefs.js:795
msgid "Coloured Icon Backgrounds"
msgstr "Sfondi colorati delle icone"

#: dockPrefs.js:796
msgid "Light each running app with its icon's main colour, as Unity did"
msgstr ""
"Illumina ogni applicazione aperta con il colore principale della sua icona, "
"come faceva Unity"

#: dockPrefs.js:797
msgid "Glossy Finish"
msgstr "Finitura lucida"

#: dockPrefs.js:805
msgid "Background"
msgstr "Sfondo"

#: dockPrefs.js:809
msgid "Custom Colour"
msgstr "Colore personalizzato"

#: dockPrefs.js:810
msgid "Use your own background colour instead of the theme's"
msgstr "Usa un colore di sfondo personale invece di quello del tema"

#: dockPrefs.js:812
msgid "Dock Colour"
msgstr "Colore della dock"

#: dockPrefs.js:822
msgid "Opacity"
msgstr "Opacità"

#: dockPrefs.js:823
msgid "Adaptive makes the dock more solid when a window is next to it"
msgstr ""
"L'opacità adattiva rende la dock più solida quando una finestra è accanto"

#: dockPrefs.js:828
msgid "Fixed Opacity"
msgstr "Opacità fissa"

#: dockPrefs.js:834
msgid "Custom Adaptive Range"
msgstr "Intervallo adattivo personalizzato"

#: dockPrefs.js:835
msgid "Choose how see-through the dock is with and without a window next to it"
msgstr "Sceglie quanto è trasparente la dock con e senza una finestra accanto"

#: dockPrefs.js:836
msgid "No Window Nearby"
msgstr "Nessuna finestra vicina"

#: dockPrefs.js:839
msgid "Window Nearby"
msgstr "Finestra vicina"

#: dockPrefs.js:851
msgid "Running App Indicators"
msgstr "Indicatori delle applicazioni aperte"

#: dockPrefs.js:852
msgid ""
"The marks under the icons of open apps. Most styles show one mark per window."
msgstr ""
"I segni sotto le icone delle applicazioni aperte. La maggior parte degli "
"stili mostra un segno per finestra."

#: dockPrefs.js:861
msgid "Match Each App's Icon"
msgstr "Come l'icona di ogni applicazione"

#: dockPrefs.js:861
msgid "Colour the indicators with the icon's main colour"
msgstr "Colora gli indicatori con il colore principale dell'icona"

#: dockPrefs.js:866
msgid "Custom Colours"
msgstr "Colori personalizzati"

#: dockPrefs.js:866
msgid "Use the same colours for every app"
msgstr "Usa gli stessi colori per ogni applicazione"

