#: dockPrefs.js:27
msgid "Focus the Window"
msgstr "聚焦窗口"

#: dockPrefs.js:28
msgid "Focus or Minimise"
msgstr "聚焦或最小化"

#: dockPrefs.js:29
msgid "Open a New Window"
msgstr "打开新窗口"

#: dockPrefs.js:30 dockPrefs.js:43
msgid "Cycle Through Windows"
msgstr "循环切换窗口"

#: dockPrefs.js:31
msgid "Minimise or Show in Overview"
msgstr "最小化或在概览中显示"

#: dockPrefs.js:32
msgid "Show Window Previews"
msgstr "显示窗口预览"

#: dockPrefs.js:33
msgid "Minimise or Show Previews"
msgstr "最小化或显示预览"

#: dockPrefs.js:34
msgid "Focus or Show Previews"
msgstr "聚焦或显示预览"

#: dockPrefs.js:35
msgid "Focus or Spread Out Windows"
msgstr "聚焦或展开窗口"

#: dockPrefs.js:36
msgid "Focus, Minimise or Show Previews"
msgstr "聚焦、最小化或显示预览"

#: dockPrefs.js:37
msgid "Focus, Minimise or Spread Out Windows"
msgstr "聚焦、最小化或展开窗口"

#: dockPrefs.js:38
msgid "Quit the App"
msgstr "退出应用"

#: dockPrefs.js:42
msgid "Do Nothing"
msgstr "无操作"

#: dockPrefs.js:44
msgid "Switch Workspace"
msgstr "切换工作区"

#: dockPrefs.js:48
msgid "Any Window"
msgstr "任意窗口"

#: dockPrefs.js:49
msgid "Windows of the Focused App"
msgstr "聚焦应用的窗口"

#: dockPrefs.js:50
msgid "Maximised Windows Only"
msgstr "仅最大化的窗口"

#: dockPrefs.js:51
msgid "Never, Stay on Top"
msgstr "从不，保持在最上层"

#: dockPrefs.js:55 dockPrefs.js:61
msgid "Theme Default"
msgstr "主题默认"

#: dockPrefs.js:56
msgid "Fixed"
msgstr "固定"

#: dockPrefs.js:57
msgid "Adaptive"
msgstr "自适应"

#: dockPrefs.js:62
msgid "Dots"
msgstr "圆点"

#: dockPrefs.js:63
msgid "Squares"
msgstr "正方形"

#: dockPrefs.js:64
msgid "Dashes"
msgstr "破折号"

#: dockPrefs.js:65
msgid "Segmented Line"
msgstr "分段线"

#: dockPrefs.js:66
msgid "Solid Line"
msgstr "实线"

#: dockPrefs.js:67
msgid "Line and Dots"
msgstr "线条和圆点"

#: dockPrefs.js:68
msgid "Full-Width Bar"
msgstr "全宽条"

#: dockPrefs.js:69
msgid "Binary Count"
msgstr "二进制计数"

#: dockPrefs.js:70
msgid "Single Dot"
msgstr "单个圆点"

#: dockPrefs.js:360
msgid "Position"
msgstr "位置"

#: dockPrefs.js:373
msgid "Placement"
msgstr "放置"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Right"
msgstr "右侧"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Left"
msgstr "左侧"

#: dockPrefs.js:381
msgid "Bottom"
msgstr "底部"

#: dockPrefs.js:382
msgid "Top"
msgstr "顶部"

#: dockPrefs.js:387
msgid "Screen Edge"
msgstr "屏幕边缘"

#: dockPrefs.js:391
msgid "Show on All Monitors"
msgstr "在所有显示器上显示"

#: dockPrefs.js:394
msgid "Monitor"
msgstr "显示器"

#: dockPrefs.js:395
msgid "The monitor the dock appears on"
msgstr "显示程序坞的显示器"

#. Translators: followed by the monitor's name and connector
#: dockPrefs.js:427
msgid "Primary"
msgstr "主显示器"

#: dockPrefs.js:442
msgid "Size"
msgstr "大小"

#: dockPrefs.js:444
msgid "Icon Size"
msgstr "图标大小"

#: dockPrefs.js:445
msgid "The largest the icons can be. They shrink to fit when the dock is full."
msgstr "图标的最大尺寸。程序坞放满时图标会缩小。"

#: dockPrefs.js:450
msgid "Keep Icons at Full Size"
msgstr "保持图标原始大小"

#: dockPrefs.js:451
msgid ""
"Scroll the dock to reach icons that do not fit, instead of shrinking them"
msgstr "滚动程序坞以查看放不下的图标，而不是缩小它们"

#: dockPrefs.js:454
msgid "Maximum Length"
msgstr "最大长度"

#: dockPrefs.js:455
msgid "How much of the screen edge the dock may use"
msgstr "程序坞可以占用的屏幕边缘长度"

#: dockPrefs.js:462
msgid "Stretch to Fill the Edge"
msgstr "拉伸以填满边缘"

#: dockPrefs.js:463
msgid "The dock runs the full length of the screen edge, like a panel"
msgstr "程序坞像面板一样占满整个屏幕边缘"

#: dockPrefs.js:464
msgid "Centre the Icons"
msgstr "图标居中"

#: dockPrefs.js:465
msgid "Keep the icons in the middle of the screen rather than at the start"
msgstr "将图标保持在屏幕中间，而不是开头"

#: dockPrefs.js:467
msgid "Show Apps Button at the Edge"
msgstr "“显示应用”按钮位于边缘"

#: dockPrefs.js:468
msgid ""
"Keep the Show Apps button at the end of the dock when the icons are centred"
msgstr "图标居中时，将“显示应用”按钮保持在程序坞末端"

#: dockPrefs.js:479
msgid "Visibility"
msgstr "可见性"

#: dockPrefs.js:481
msgid ""
"When the dock hides, it comes back when you move the pointer to its edge of "
"the screen."
msgstr "程序坞隐藏后，将指针移到其所在的屏幕边缘即可让它回来。"

#: dockPrefs.js:485
msgid "Always Visible"
msgstr "始终可见"

#: dockPrefs.js:486
msgid ""
"Keep the dock on screen and fit windows around it. Turn off to let the dock "
"hide."
msgstr "让程序坞保持在屏幕上，窗口围绕它调整。关闭后程序坞可以隐藏。"

#: dockPrefs.js:489
msgid "Hide When Windows Overlap"
msgstr "窗口重叠时隐藏"

#: dockPrefs.js:490
msgid "The dock steps aside when a window would cover it"
msgstr "当窗口会遮住程序坞时，程序坞会让开"

#: dockPrefs.js:491
msgid "Windows That Hide the Dock"
msgstr "会隐藏程序坞的窗口"

#: dockPrefs.js:496
msgid "Show When Pointer Reaches the Edge"
msgstr "指针到达边缘时显示"

#: dockPrefs.js:497
msgid "Reveal the hidden dock by moving the pointer to the screen edge"
msgstr "将指针移到屏幕边缘时显示隐藏的程序坞"

#: dockPrefs.js:498
msgid "Push to Reveal"
msgstr "推动以显示"

#: dockPrefs.js:499
msgid ""
"Only show the dock when you push the pointer against the edge, to avoid "
"showing it by accident"
msgstr "只有将指针推向边缘时才显示程序坞，避免意外显示"

#: dockPrefs.js:502
msgid "Push Strength"
msgstr "推动力度"

#: dockPrefs.js:503
msgid "How hard you need to push, in pixels of pointer movement"
msgstr "需要推动的力度，以指针移动的像素计"

#: dockPrefs.js:506
msgid "Show Delay"
msgstr "显示延迟"

#: dockPrefs.js:507
msgid "Seconds to wait at the edge before the dock appears"
msgstr "指针到达边缘后程序坞出现前等待的秒数"

#: dockPrefs.js:510
msgid "Also in Full-Screen Apps"
msgstr "全屏应用中也显示"

#: dockPrefs.js:511
msgid "Allow the dock to appear over full-screen windows"
msgstr "允许程序坞显示在全屏窗口上方"

#: dockPrefs.js:513
msgid "Show for Apps That Need Attention"
msgstr "为需要关注的应用显示"

#: dockPrefs.js:514
msgid "Briefly show the dock when an app asks for your attention"
msgstr "应用需要关注时短暂显示程序坞"

#: dockPrefs.js:518
msgid "Hide Delay"
msgstr "隐藏延迟"

#: dockPrefs.js:519
msgid "Seconds to wait after the pointer leaves before the dock hides"
msgstr "指针离开后程序坞隐藏前等待的秒数"

#: dockPrefs.js:523
msgid "Animation Duration"
msgstr "动画时长"

#: dockPrefs.js:524
msgid "Seconds the dock takes to slide in and out"
msgstr "程序坞滑入滑出所需的秒数"

#: dockPrefs.js:537
msgid "Behaviour"
msgstr "行为"

#: dockPrefs.js:556
msgid "StackDock Extras"
msgstr "StackDock 附加功能"

#: dockPrefs.js:557
msgid "Optional features added by StackDock."
msgstr "StackDock 添加的可选功能。"

#: dockPrefs.js:560
msgid "Previews on Hover"
msgstr "悬停预览"

#: dockPrefs.js:561
msgid "Show an app's windows when the pointer rests on its icon"
msgstr "指针停留在图标上时显示应用的窗口"

#: dockPrefs.js:562
msgid "Delay"
msgstr "延迟"

#: dockPrefs.js:563
msgid "Milliseconds to wait before the previews appear"
msgstr "显示预览前等待的毫秒数"

#: dockPrefs.js:566
msgid "Bounce While Launching"
msgstr "启动时弹跳"

#: dockPrefs.js:567
msgid "Bounce an app's icon while it starts, until its window appears"
msgstr "应用启动时让其图标弹跳，直到窗口出现"

#: dockPrefs.js:569
msgid "Match the Top Bar"
msgstr "匹配顶栏"

#: dockPrefs.js:570
msgid "Give the top bar the same colour and opacity as the dock"
msgstr "让顶栏与程序坞使用相同的颜色和不透明度"

#: dockPrefs.js:579
msgid "Dock Contents"
msgstr "程序坞内容"

#: dockPrefs.js:581
msgid "Pinned Apps"
msgstr "已固定的应用"

#: dockPrefs.js:582
msgid "Running Apps"
msgstr "运行中的应用"

#: dockPrefs.js:583
msgid "Apps that are open but not pinned"
msgstr "已打开但未固定的应用"

#: dockPrefs.js:586
msgid "Show Apps Button"
msgstr "“显示应用”按钮"

#: dockPrefs.js:587
msgid "Opens the app grid"
msgstr "打开应用网格"

#: dockPrefs.js:588
msgid "Place at the Start"
msgstr "放在开头"

#: dockPrefs.js:589
msgid "Put the button before the apps instead of after them"
msgstr "将按钮放在应用之前而不是之后"

#: dockPrefs.js:598
msgid "Workspaces and Monitors"
msgstr "工作区和显示器"

#: dockPrefs.js:604
msgid "Only Apps on the Current Workspace"
msgstr "仅当前工作区的应用"

#: dockPrefs.js:615
msgid "Show running apps only on the workspace they are on"
msgstr "仅在应用所在的工作区显示运行中的应用"

#: dockPrefs.js:616
msgid "Follows the Multitasking setting in GNOME Settings"
msgstr "跟随 GNOME 设置中的多任务设置"

#: dockPrefs.js:632
msgid "Show Apps Needing Attention Everywhere"
msgstr "在所有位置显示需要关注的应用"

#: dockPrefs.js:633
msgid "Apps asking for attention appear on every workspace"
msgstr "需要关注的应用会出现在每个工作区"

#: dockPrefs.js:635
msgid "Only Apps on the Same Monitor"
msgstr "仅同一显示器上的应用"

#: dockPrefs.js:636
msgid "With a dock on each monitor, each shows only the apps on its monitor"
msgstr "每个显示器都有程序坞时，每个程序坞只显示所在显示器上的应用"

#: dockPrefs.js:639
msgid "Separate Trash and Drive Windows"
msgstr "分开回收站和驱动器窗口"

#: dockPrefs.js:640
msgid "Treat Files windows showing the trash or a drive as their own icons"
msgstr "将显示回收站或驱动器的“文件”窗口视为单独的图标"

#: dockPrefs.js:652
msgid "Clicking and Scrolling"
msgstr "单击和滚动"

#: dockPrefs.js:653
msgid "What happens when you click an app that is already open."
msgstr "单击已打开的应用时的操作。"

#: dockPrefs.js:658
msgid "Click"
msgstr "单击"

#: dockPrefs.js:662
msgid "Other Clicks"
msgstr "其他单击"

#: dockPrefs.js:663
msgid "Shift+click, middle-click and Shift+middle-click"
msgstr "Shift+单击、中键单击和 Shift+中键单击"

#: dockPrefs.js:665
msgid "Shift+Click"
msgstr "Shift+单击"

#: dockPrefs.js:666
msgid "Middle-Click"
msgstr "中键单击"

#: dockPrefs.js:667
msgid "Shift+Middle-Click"
msgstr "Shift+中键单击"

#: dockPrefs.js:671
msgid "Scroll"
msgstr "滚动"

#: dockPrefs.js:674
msgid ""
"Only works between icons, because Keep Icons at Full Size scrolls the dock"
msgstr "仅在图标之间有效，因为“保持图标原始大小”会滚动程序坞"

#: dockPrefs.js:675
msgid "Scrolling over an app's icon"
msgstr "在应用图标上滚动"

#: dockPrefs.js:684
msgid "Window Previews"
msgstr "窗口预览"

#: dockPrefs.js:686
msgid "Previews in App Menus"
msgstr "应用菜单中的预览"

#: dockPrefs.js:687
msgid "Show pictures of the open windows instead of a list of their names"
msgstr "显示打开窗口的图像，而不是名称列表"

#: dockPrefs.js:689
msgid "Preview Size"
msgstr "预览大小"

#: dockPrefs.js:690
msgid "Leave at Automatic to fit the screen"
msgstr "保持“自动”以适应屏幕"

#: dockPrefs.js:692 stacks.js:2239 stacksPrefs.js:105
msgid "Automatic"
msgstr "自动"

#: dockPrefs.js:700
msgid "Icons"
msgstr "图标"

#: dockPrefs.js:702
msgid "Wiggle Apps Needing Attention"
msgstr "摇动需要关注的应用"

#: dockPrefs.js:703
msgid "Hide Name Tooltips"
msgstr "隐藏名称提示"

#: dockPrefs.js:704
msgid "Don't show the app's name when the pointer rests on its icon"
msgstr "指针停留在图标上时不显示应用名称"

#: dockPrefs.js:705
msgid "Keep the Focused App in View"
msgstr "保持聚焦的应用可见"

#: dockPrefs.js:706
msgid "Scroll the dock so the icon of the focused app is always visible"
msgstr "滚动程序坞，使聚焦应用的图标始终可见"

#: dockPrefs.js:708
msgid "Badges"
msgstr "徽章"

#: dockPrefs.js:709
msgid "Counters and progress bars on app icons"
msgstr "应用图标上的计数和进度条"

#: dockPrefs.js:711
msgid "Unread Notification Count"
msgstr "未读通知数"

#: dockPrefs.js:714
msgid "Prefer the App's Own Count"
msgstr "优先使用应用自己的计数"

#: dockPrefs.js:715
msgid "Apps that set their own badge show it instead of the notification count"
msgstr "有自己徽章的应用将显示其徽章，而不是通知数"

#: dockPrefs.js:725
msgid "Keyboard"
msgstr "键盘"

#: dockPrefs.js:727
msgid "Open Apps with Super+Number"
msgstr "用 Super+数字键打开应用"

#: dockPrefs.js:728
msgid ""
"Super+1 to Super+0 open the first ten apps. Add Shift or Ctrl for more "
"actions."
msgstr "Super+1 到 Super+0 打开前十个应用。加上 Shift 或 Ctrl 可执行更多操作。"

#: dockPrefs.js:729
msgid "Show Numbers on Icons"
msgstr "在图标上显示数字"

#: dockPrefs.js:730
msgid "Show each app's number while the shortcut below is held"
msgstr "按住下方快捷键时显示每个应用的数字"

#: dockPrefs.js:731
msgid "Show the Dock"
msgstr "显示程序坞"

#: dockPrefs.js:732
msgid "Briefly show a hidden dock when the shortcut below is pressed"
msgstr "按下下方快捷键时短暂显示隐藏的程序坞"

#: dockPrefs.js:735
msgid "Shortcut to Show Numbers"
msgstr "显示数字的快捷键"

#: dockPrefs.js:744
msgid "For example &lt;Super&gt;q"
msgstr "例如 &lt;Super&gt;q"

#: dockPrefs.js:751
msgid "Numbers Stay For"
msgstr "数字显示时长"

#: dockPrefs.js:752
msgid "Seconds the numbers and dock stay visible"
msgstr "数字和程序坞保持可见的秒数"

#: dockPrefs.js:759
msgid "Startup"
msgstr "启动"

#: dockPrefs.js:761
msgid "Show the Overview at Login"
msgstr "登录时显示概览"

#: dockPrefs.js:762
msgid "Open Activities when you log in, as GNOME does by default"
msgstr "像 GNOME 默认那样，登录时打开活动概览"

#: dockPrefs.js:773
msgid "Appearance"
msgstr "外观"

#: dockPrefs.js:786 dockPrefs.js:856
msgid "Style"
msgstr "样式"

#: dockPrefs.js:788
msgid "Use the Built-in Style"
msgstr "使用内置样式"

#: dockPrefs.js:789
msgid ""
"A ready-made look that suits the default GNOME theme. Turn off to choose the "
"colours, opacity and indicators yourself."
msgstr ""
"适合 GNOME 默认主题的现成外观。关闭后可自行选择颜色、不透明度和指示器。"

#: dockPrefs.js:791
msgid "Compact"
msgstr "紧凑"

#: dockPrefs.js:792
msgid "Less padding and smaller rounded corners"
msgstr "更少的内边距和更小的圆角"

#: dockPrefs.js:793
msgid "Square Corners"
msgstr "直角"

#: dockPrefs.js:795
msgid "Coloured Icon Backgrounds"
msgstr "彩色图标背景"

#: dockPrefs.js:796
msgid "Light each running app with its icon's main colour, as Unity did"
msgstr "像 Unity 一样，用图标的主色照亮每个运行中的应用"

#: dockPrefs.js:797
msgid "Glossy Finish"
msgstr "光泽效果"

#: dockPrefs.js:805
msgid "Background"
msgstr "背景"

#: dockPrefs.js:809
msgid "Custom Colour"
msgstr "自定义颜色"

#: dockPrefs.js:810
msgid "Use your own background colour instead of the theme's"
msgstr "使用自己的背景颜色，而不是主题的颜色"

#: dockPrefs.js:812
msgid "Dock Colour"
msgstr "程序坞颜色"

#: dockPrefs.js:822
msgid "Opacity"
msgstr "不透明度"

#: dockPrefs.js:823
msgid "Adaptive makes the dock more solid when a window is next to it"
msgstr "自适应模式下，旁边有窗口时程序坞会更不透明"

#: dockPrefs.js:828
msgid "Fixed Opacity"
msgstr "固定不透明度"

#: dockPrefs.js:834
msgid "Custom Adaptive Range"
msgstr "自定义自适应范围"

#: dockPrefs.js:835
msgid "Choose how see-through the dock is with and without a window next to it"
msgstr "选择旁边有窗口和没有窗口时程序坞的透明程度"

#: dockPrefs.js:836
msgid "No Window Nearby"
msgstr "附近无窗口"

#: dockPrefs.js:839
msgid "Window Nearby"
msgstr "附近有窗口"

#: dockPrefs.js:851
msgid "Running App Indicators"
msgstr "运行中应用的指示器"

#: dockPrefs.js:852
