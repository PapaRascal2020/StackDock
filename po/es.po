#: dockPrefs.js:27
msgid "Focus the Window"
msgstr "Enfocar la ventana"

#: dockPrefs.js:28
msgid "Focus or Minimise"
msgstr "Enfocar o minimizar"

#: dockPrefs.js:29
msgid "Open a New Window"
msgstr "Abrir una ventana nueva"

#: dockPrefs.js:30 dockPrefs.js:43
msgid "Cycle Through Windows"
msgstr "Recorrer las ventanas"

#: dockPrefs.js:31
msgid "Minimise or Show in Overview"
msgstr "Minimizar o mostrar en la vista general"

#: dockPrefs.js:32
msgid "Show Window Previews"
msgstr "Mostrar vistas previas de las ventanas"

#: dockPrefs.js:33
msgid "Minimise or Show Previews"
msgstr "Minimizar o mostrar vistas previas"

#: dockPrefs.js:34
msgid "Focus or Show Previews"
msgstr "Enfocar o mostrar vistas previas"

#: dockPrefs.js:35
msgid "Focus or Spread Out Windows"
msgstr "Enfocar o extender las ventanas"

#: dockPrefs.js:36
msgid "Focus, Minimise or Show Previews"
msgstr "Enfocar, minimizar o mostrar vistas previas"

#: dockPrefs.js:37
msgid "Focus, Minimise or Spread Out Windows"
msgstr "Enfocar, minimizar o extender las ventanas"

#: dockPrefs.js:38
msgid "Quit the App"
msgstr "Salir de la aplicación"

#: dockPrefs.js:42
msgid "Do Nothing"
msgstr "No hacer nada"

#: dockPrefs.js:44
msgid "Switch Workspace"
msgstr "Cambiar de área de trabajo"

#: dockPrefs.js:48
msgid "Any Window"
msgstr "Cualquier ventana"

#: dockPrefs.js:49
msgid "Windows of the Focused App"
msgstr "Ventanas de la aplicación enfocada"

#: dockPrefs.js:50
msgid "Maximised Windows Only"
msgstr "Solo ventanas maximizadas"

#: dockPrefs.js:51
msgid "Never, Stay on Top"
msgstr "Nunca, quedarse encima"

#: dockPrefs.js:55 dockPrefs.js:61
msgid "Theme Default"
msgstr "Predeterminado del tema"

#: dockPrefs.js:56
msgid "Fixed"
msgstr "Fijo"

#: dockPrefs.js:57
msgid "Adaptive"
msgstr "Adaptativa"

#: dockPrefs.js:62
msgid "Dots"
msgstr "Puntos"

#: dockPrefs.js:63
msgid "Squares"
msgstr "Cuadrados"

#: dockPrefs.js:64
msgid "Dashes"
msgstr "Rayas"

#: dockPrefs.js:65
msgid "Segmented Line"
msgstr "Línea segmentada"

#: dockPrefs.js:66
msgid "Solid Line"
msgstr "Línea continua"

#: dockPrefs.js:67
msgid "Line and Dots"
msgstr "Línea y puntos"

#: dockPrefs.js:68
msgid "Full-Width Bar"
msgstr "Barra de ancho completo"

#: dockPrefs.js:69
msgid "Binary Count"
msgstr "Contador binario"

#: dockPrefs.js:70
msgid "Single Dot"
msgstr "Punto único"

#: dockPrefs.js:360
msgid "Position"
msgstr "Posición"

#: dockPrefs.js:373
msgid "Placement"
msgstr "Ubicación"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Right"
msgstr "Derecha"

#: dockPrefs.js:380 dockPrefs.js:383
msgid "Left"
msgstr "Izquierda"

#: dockPrefs.js:381
msgid "Bottom"
msgstr "Inferior"

#: dockPrefs.js:382
msgid "Top"
msgstr "Superior"

#: dockPrefs.js:387
msgid "Screen Edge"
msgstr "Borde de la pantalla"

#: dockPrefs.js:391
msgid "Show on All Monitors"
msgstr "Mostrar en todos los monitores"

#: dockPrefs.js:394
msgid "Monitor"
msgstr "Monitor"

#: dockPrefs.js:395
msgid "The monitor the dock appears on"
msgstr "El monitor en el que aparece el dock"

#. Translators: followed by the monitor's name and connector
#: dockPrefs.js:427
msgid "Primary"
msgstr "Principal"

#: dockPrefs.js:442
msgid "Size"
msgstr "Tamaño"

#: dockPrefs.js:444
msgid "Icon Size"
msgstr "Tamaño de los iconos"

#: dockPrefs.js:445
msgid "The largest the icons can be. They shrink to fit when the dock is full."
msgstr "El tamaño máximo de los iconos. Se reducen cuando el dock está lleno."

#: dockPrefs.js:450
msgid "Keep Icons at Full Size"
msgstr "Mantener los iconos a tamaño completo"

#: dockPrefs.js:451
msgid ""
"Scroll the dock to reach icons that do not fit, instead of shrinking them"
msgstr ""
"Desplazar el dock para llegar a los iconos que no caben, en lugar de "
"reducirlos"

#: dockPrefs.js:454
msgid "Maximum Length"
msgstr "Longitud máxima"

#: dockPrefs.js:455
msgid "How much of the screen edge the dock may use"
msgstr "Qué parte del borde de la pantalla puede usar el dock"

#: dockPrefs.js:462
msgid "Stretch to Fill the Edge"
msgstr "Estirar hasta llenar el borde"

#: dockPrefs.js:463
msgid "The dock runs the full length of the screen edge, like a panel"
msgstr "El dock ocupa todo el borde de la pantalla, como un panel"

#: dockPrefs.js:464
msgid "Centre the Icons"
msgstr "Centrar los iconos"

#: dockPrefs.js:465
msgid "Keep the icons in the middle of the screen rather than at the start"
msgstr ""
"Mantener los iconos en el centro de la pantalla en lugar de al principio"

#: dockPrefs.js:467
msgid "Show Apps Button at the Edge"
msgstr "Botón Mostrar aplicaciones en el borde"

#: dockPrefs.js:468
msgid ""
"Keep the Show Apps button at the end of the dock when the icons are centred"
msgstr ""
"Mantener el botón Mostrar aplicaciones al final del dock cuando los iconos "
"están centrados"

#: dockPrefs.js:479
msgid "Visibility"
msgstr "Visibilidad"

#: dockPrefs.js:481
msgid ""
"When the dock hides, it comes back when you move the pointer to its edge of "
"the screen."
msgstr ""
"Cuando el dock se oculta, vuelve al mover el puntero a su borde de la "
"pantalla."

#: dockPrefs.js:485
msgid "Always Visible"
msgstr "Siempre visible"

#: dockPrefs.js:486
msgid ""
"Keep the dock on screen and fit windows around it. Turn off to let the dock "
"hide."
msgstr ""
"Mantener el dock en pantalla y ajustar las ventanas a su alrededor. "
"Desactívelo para que el dock se pueda ocultar."

#: dockPrefs.js:489
msgid "Hide When Windows Overlap"
msgstr "Ocultar cuando las ventanas lo cubran"

#: dockPrefs.js:490
msgid "The dock steps aside when a window would cover it"
msgstr "El dock se aparta cuando una ventana lo cubriría"

#: dockPrefs.js:491
msgid "Windows That Hide the Dock"
msgstr "Ventanas que ocultan el dock"

#: dockPrefs.js:496
msgid "Show When Pointer Reaches the Edge"
msgstr "Mostrar cuando el puntero llegue al borde"

#: dockPrefs.js:497
msgid "Reveal the hidden dock by moving the pointer to the screen edge"
msgstr "Mostrar el dock oculto moviendo el puntero al borde de la pantalla"

#: dockPrefs.js:498
msgid "Push to Reveal"
msgstr "Empujar para mostrar"

#: dockPrefs.js:499
msgid ""
"Only show the dock when you push the pointer against the edge, to avoid "
"showing it by accident"
msgstr ""
"Mostrar el dock solo al empujar el puntero contra el borde, para evitar "
"mostrarlo por accidente"

#: dockPrefs.js:502
msgid "Push Strength"
msgstr "Fuerza del empuje"

#: dockPrefs.js:503
msgid "How hard you need to push, in pixels of pointer movement"
msgstr ""
"La fuerza con la que hay que empujar, en píxeles de movimiento del puntero"

#: dockPrefs.js:506
msgid "Show Delay"
msgstr "Retardo al mostrar"

#: dockPrefs.js:507
msgid "Seconds to wait at the edge before the dock appears"
msgstr "Segundos de espera en el borde antes de que aparezca el dock"

#: dockPrefs.js:510
msgid "Also in Full-Screen Apps"
msgstr "También en aplicaciones a pantalla completa"

#: dockPrefs.js:511
msgid "Allow the dock to appear over full-screen windows"
msgstr "Permitir que el dock aparezca sobre las ventanas a pantalla completa"

#: dockPrefs.js:513
msgid "Show for Apps That Need Attention"
msgstr "Mostrar para las aplicaciones que requieren atención"

#: dockPrefs.js:514
msgid "Briefly show the dock when an app asks for your attention"
msgstr "Mostrar brevemente el dock cuando una aplicación requiere atención"

#: dockPrefs.js:518
msgid "Hide Delay"
msgstr "Retardo al ocultar"

#: dockPrefs.js:519
msgid "Seconds to wait after the pointer leaves before the dock hides"
msgstr "Segundos de espera tras salir el puntero antes de ocultar el dock"

#: dockPrefs.js:523
msgid "Animation Duration"
msgstr "Duración de la animación"

#: dockPrefs.js:524
msgid "Seconds the dock takes to slide in and out"
msgstr "Segundos que tarda el dock en aparecer y desaparecer"

#: dockPrefs.js:537
msgid "Behaviour"
msgstr "Comportamiento"

#: dockPrefs.js:556
msgid "StackDock Extras"
msgstr "Extras de StackDock"

#: dockPrefs.js:557
msgid "Optional features added by StackDock."
msgstr "Funciones opcionales añadidas por StackDock."

#: dockPrefs.js:560
msgid "Previews on Hover"
msgstr "Vistas previas al pasar el puntero"

#: dockPrefs.js:561
msgid "Show an app's windows when the pointer rests on its icon"
msgstr ""
"Mostrar las ventanas de una aplicación cuando el puntero se detiene sobre su "
"icono"

#: dockPrefs.js:562
msgid "Delay"
msgstr "Retardo"

#: dockPrefs.js:563
msgid "Milliseconds to wait before the previews appear"
msgstr "Milisegundos de espera antes de que aparezcan las vistas previas"

#: dockPrefs.js:566
msgid "Bounce While Launching"
msgstr "Rebotar al iniciar"

#: dockPrefs.js:567
msgid "Bounce an app's icon while it starts, until its window appears"
msgstr ""
"Hacer rebotar el icono de una aplicación mientras se inicia, hasta que "
"aparezca su ventana"

#: dockPrefs.js:569
msgid "Match the Top Bar"
msgstr "Igualar la barra superior"

#: dockPrefs.js:570
msgid "Give the top bar the same colour and opacity as the dock"
msgstr "Dar a la barra superior el mismo color y opacidad que el dock"

#: dockPrefs.js:579
msgid "Dock Contents"
msgstr "Contenido del dock"

#: dockPrefs.js:581
msgid "Pinned Apps"
msgstr "Aplicaciones fijadas"

#: dockPrefs.js:582
msgid "Running Apps"
msgstr "Aplicaciones abiertas"

#: dockPrefs.js:583
msgid "Apps that are open but not pinned"
msgstr "Aplicaciones abiertas pero no fijadas"

#: dockPrefs.js:586
msgid "Show Apps Button"
msgstr "Botón Mostrar aplicaciones"

#: dockPrefs.js:587
msgid "Opens the app grid"
msgstr "Abre la cuadrícula de aplicaciones"

#: dockPrefs.js:588
msgid "Place at the Start"
msgstr "Colocar al principio"

#: dockPrefs.js:589
msgid "Put the button before the apps instead of after them"
msgstr "Colocar el botón antes de las aplicaciones en lugar de después"

#: dockPrefs.js:598
msgid "Workspaces and Monitors"
msgstr "Áreas de trabajo y monitores"

#: dockPrefs.js:604
msgid "Only Apps on the Current Workspace"
msgstr "Solo aplicaciones del área de trabajo actual"

#: dockPrefs.js:615
msgid "Show running apps only on the workspace they are on"
msgstr "Mostrar las aplicaciones abiertas solo en su área de trabajo"

#: dockPrefs.js:616
msgid "Follows the Multitasking setting in GNOME Settings"
msgstr "Sigue el ajuste de Multitarea de la Configuración de GNOME"

#: dockPrefs.js:632
msgid "Show Apps Needing Attention Everywhere"
msgstr "Mostrar en todas partes las aplicaciones que requieren atención"

#: dockPrefs.js:633
msgid "Apps asking for attention appear on every workspace"
msgstr ""
"Las aplicaciones que requieren atención aparecen en todas las áreas de "
"trabajo"

#: dockPrefs.js:635
msgid "Only Apps on the Same Monitor"
msgstr "Solo aplicaciones del mismo monitor"

#: dockPrefs.js:636
msgid "With a dock on each monitor, each shows only the apps on its monitor"
msgstr ""
"Con un dock en cada monitor, cada uno muestra solo las aplicaciones de su "
"monitor"

#: dockPrefs.js:639
msgid "Separate Trash and Drive Windows"
msgstr "Separar las ventanas de la papelera y de las unidades"

#: dockPrefs.js:640
msgid "Treat Files windows showing the trash or a drive as their own icons"
msgstr ""
"Tratar las ventanas de Archivos que muestran la papelera o una unidad como "
"iconos propios"

#: dockPrefs.js:652
msgid "Clicking and Scrolling"
msgstr "Clic y desplazamiento"

#: dockPrefs.js:653
msgid "What happens when you click an app that is already open."
msgstr "Qué ocurre al hacer clic en una aplicación que ya está abierta."

#: dockPrefs.js:658
msgid "Click"
msgstr "Clic"

#: dockPrefs.js:662
msgid "Other Clicks"
msgstr "Otros clics"

#: dockPrefs.js:663
msgid "Shift+click, middle-click and Shift+middle-click"
msgstr "Mayús+clic, clic central y Mayús+clic central"

#: dockPrefs.js:665
msgid "Shift+Click"
msgstr "Mayús+clic"

#: dockPrefs.js:666
msgid "Middle-Click"
msgstr "Clic central"

#: dockPrefs.js:667
msgid "Shift+Middle-Click"
msgstr "Mayús+clic central"

#: dockPrefs.js:671
msgid "Scroll"
msgstr "Desplazamiento"

#: dockPrefs.js:674
msgid ""
"Only works between icons, because Keep Icons at Full Size scrolls the dock"
msgstr ""
"Solo funciona entre iconos, porque «Mantener los iconos a tamaño completo» "
"desplaza el dock"

#: dockPrefs.js:675
msgid "Scrolling over an app's icon"
msgstr "Desplazamiento sobre el icono de una aplicación"

#: dockPrefs.js:684
msgid "Window Previews"
msgstr "Vistas previas de las ventanas"

#: dockPrefs.js:686
msgid "Previews in App Menus"
msgstr "Vistas previas en los menús de aplicaciones"

#: dockPrefs.js:687
msgid "Show pictures of the open windows instead of a list of their names"
msgstr ""
"Mostrar imágenes de las ventanas abiertas en lugar de una lista de sus "
"nombres"

#: dockPrefs.js:689
msgid "Preview Size"
msgstr "Tamaño de las vistas previas"

#: dockPrefs.js:690
msgid "Leave at Automatic to fit the screen"
msgstr "Déjelo en Automático para ajustarse a la pantalla"

#: dockPrefs.js:692 stacks.js:2239 stacksPrefs.js:105
msgid "Automatic"
msgstr "Automático"

#: dockPrefs.js:700
msgid "Icons"
msgstr "Iconos"

#: dockPrefs.js:702
msgid "Wiggle Apps Needing Attention"
msgstr "Agitar las aplicaciones que requieren atención"

#: dockPrefs.js:703
msgid "Hide Name Tooltips"
msgstr "Ocultar las etiquetas de nombre"

#: dockPrefs.js:704
msgid "Don't show the app's name when the pointer rests on its icon"
msgstr ""
"No mostrar el nombre de la aplicación cuando el puntero se detiene sobre su "
"icono"

#: dockPrefs.js:705
msgid "Keep the Focused App in View"
msgstr "Mantener visible la aplicación enfocada"

#: dockPrefs.js:706
msgid "Scroll the dock so the icon of the focused app is always visible"
msgstr ""
"Desplazar el dock para que el icono de la aplicación enfocada esté siempre "
"visible"

#: dockPrefs.js:708
msgid "Badges"
msgstr "Insignias"

#: dockPrefs.js:709
msgid "Counters and progress bars on app icons"
msgstr "Contadores y barras de progreso en los iconos de las aplicaciones"

#: dockPrefs.js:711
msgid "Unread Notification Count"
msgstr "Número de notificaciones sin leer"

#: dockPrefs.js:714
msgid "Prefer the App's Own Count"
msgstr "Preferir el contador de la aplicación"

#: dockPrefs.js:715
msgid "Apps that set their own badge show it instead of the notification count"
msgstr ""
"Las aplicaciones con su propio contador lo muestran en lugar del número de "
"notificaciones"

#: dockPrefs.js:725
msgid "Keyboard"
msgstr "Teclado"

#: dockPrefs.js:727
msgid "Open Apps with Super+Number"
msgstr "Abrir aplicaciones con Súper+número"

#: dockPrefs.js:728
msgid ""
"Super+1 to Super+0 open the first ten apps. Add Shift or Ctrl for more "
"actions."
msgstr ""
"Súper+1 a Súper+0 abren las diez primeras aplicaciones. Añada Mayús o Ctrl "
"para más acciones."

#: dockPrefs.js:729
msgid "Show Numbers on Icons"
msgstr "Mostrar números en los iconos"

#: dockPrefs.js:730
msgid "Show each app's number while the shortcut below is held"
msgstr ""
"Mostrar el número de cada aplicación mientras se mantiene el atajo de abajo"

#: dockPrefs.js:731
msgid "Show the Dock"
msgstr "Mostrar el dock"

#: dockPrefs.js:732
msgid "Briefly show a hidden dock when the shortcut below is pressed"
msgstr "Mostrar brevemente un dock oculto al pulsar el atajo de abajo"

#: dockPrefs.js:735
msgid "Shortcut to Show Numbers"
msgstr "Atajo para mostrar los números"

#: dockPrefs.js:744
msgid "For example &lt;Super&gt;q"
msgstr "Por ejemplo &lt;Super&gt;q"

#: dockPrefs.js:751
msgid "Numbers Stay For"
msgstr "Los números se muestran durante"

#: dockPrefs.js:752
msgid "Seconds the numbers and dock stay visible"
msgstr "Segundos que los números y el dock permanecen visibles"

#: dockPrefs.js:759
msgid "Startup"
msgstr "Inicio"

#: dockPrefs.js:761
msgid "Show the Overview at Login"
msgstr "Mostrar la vista general al iniciar sesión"

#: dockPrefs.js:762
msgid "Open Activities when you log in, as GNOME does by default"
msgstr ""
"Abrir Actividades al iniciar sesión, como hace GNOME de forma predeterminada"

#: dockPrefs.js:773
msgid "Appearance"
msgstr "Apariencia"

#: dockPrefs.js:786 dockPrefs.js:856
msgid "Style"
msgstr "Estilo"

#: dockPrefs.js:788
msgid "Use the Built-in Style"
msgstr "Usar el estilo integrado"

#: dockPrefs.js:789
msgid ""
"A ready-made look that suits the default GNOME theme. Turn off to choose the "
"colours, opacity and indicators yourself."
msgstr ""
"Un aspecto listo para usar que combina con el tema predeterminado de GNOME. "
"Desactívelo para elegir usted mismo los colores, la opacidad y los "
"indicadores."

#: dockPrefs.js:791
msgid "Compact"
msgstr "Compacto"

#: dockPrefs.js:792
msgid "Less padding and smaller rounded corners"
msgstr "Menos relleno y esquinas menos redondeadas"

#: dockPrefs.js:793
msgid "Square Corners"
msgstr "Esquinas rectas"

#: dockPrefs.js:795
msgid "Coloured Icon Backgrounds"
msgstr "Fondos de icono de color"

#: dockPrefs.js:796
msgid "Light each running app with its icon's main colour, as Unity did"
msgstr ""
"Iluminar cada aplicación abierta con el color principal de su icono, como "
"hacía Unity"

#: dockPrefs.js:797
msgid "Glossy Finish"
msgstr "Acabado brillante"

#: dockPrefs.js:805
msgid "Background"
msgstr "Fondo"

#: dockPrefs.js:809
msgid "Custom Colour"
msgstr "Color personalizado"

#: dockPrefs.js:810
msgid "Use your own background colour instead of the theme's"
msgstr "Usar su propio color de fondo en lugar del del tema"

#: dockPrefs.js:812
msgid "Dock Colour"
msgstr "Color del dock"

#: dockPrefs.js:822
msgid "Opacity"
msgstr "Opacidad"

#: dockPrefs.js:823
msgid "Adaptive makes the dock more solid when a window is next to it"
msgstr ""
"La opacidad adaptativa hace el dock más sólido cuando hay una ventana al lado"

#: dockPrefs.js:828
msgid "Fixed Opacity"
msgstr "Opacidad fija"

#: dockPrefs.js:834
msgid "Custom Adaptive Range"
msgstr "Rango adaptativo personalizado"

#: dockPrefs.js:835
msgid "Choose how see-through the dock is with and without a window next to it"
msgstr "Elegir la transparencia del dock con y sin una ventana al lado"

#: dockPrefs.js:836
msgid "No Window Nearby"
msgstr "Sin ventana cerca"

#: dockPrefs.js:839
msgid "Window Nearby"
msgstr "Ventana cerca"

#: dockPrefs.js:851
msgid "Running App Indicators"
msgstr "Indicadores de aplicaciones abiertas"

#: dockPrefs.js:852
msgid ""
"The marks under the icons of open apps. Most styles show one mark per window."
msgstr ""
"Las marcas bajo los iconos de las aplicaciones abiertas. La mayoría de los "
"estilos muestran una marca por ventana."

#: dockPrefs.js:861
msgid "Match Each App's Icon"
msgstr "Igual que el icono de cada aplicación"

#: dockPrefs.js:861
msgid "Colour the indicators with the icon's main colour"
msgstr "Colorear los indicadores con el color principal del icono"

#: dockPrefs.js:866
msgid "Custom Colours"
msgstr "Colores personalizados"

#: dockPrefs.js:866
msgid "Use the same colours for every app"
msgstr "Usar los mismos colores para todas las aplicaciones"

#: dockPrefs.js:867
msgid "Colour"
msgstr "Color"

