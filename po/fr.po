#: dockPrefs.js:27
msgid "Focus the Window"
msgstr "Activer la fenêtre"

#: dockPrefs.js:28
msgid "Focus or Minimise"
msgstr "Activer ou réduire"

#: dockPrefs.js:29
msgid "Open a New Window"
msgstr "Ouvrir une nouvelle fenêtre"

#: dockPrefs.js:30 dockPrefs.js:43
msgid "Cycle Through Windows"
msgstr "Parcourir les fenêtres"

#: dockPrefs.js:31
msgid "Minimise or Show in Overview"
msgstr "Réduire ou afficher dans la vue d’ensemble"

#: dockPrefs.js:32
